#!/bin/sh
# Xfce infrastructure with i3 as the window manager.
# Deliberately does not use xfce4-session: fewer moving parts, no session
# save/restore fighting i3 over window placement.

export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce-i3

# Restore physical touchpad scroll phases for Qt applications on X11.
export QT_QPA_GENERIC_PLUGINS="${QT_QPA_GENERIC_PLUGINS:+$QT_QPA_GENERIC_PLUGINS,}scrollphases"

# The dock right-to-left (new programs at its left edge): a GTK module that acts only
# inside the panel wrapper hosting docklike - see assets/dock-rtl/README.md.
export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}$HOME/.local/share/sky-desktop/libdock-rtl.so"

# HiDPI: 2560x1600 on 13" — 1.5x
xrdb -merge "$HOME/.Xresources" 2>/dev/null

xsetroot -solid '@COLOUR_BACKGROUND@' &

# Xfce pieces worth keeping
xfsettingsd &                                   # themes, fonts, keyboard layouts
sleep 1                                         # let DPI/theme settle before the panel reads them
xfce4-power-manager &                           # battery, lid, brightness keys
xfce4-panel &                                   # panel, systray, clock, volume, layout
Thunar --daemon &
touchegg &                                      # gesture client (daemon is a system service)

# desktop niceties
# xcompmgr, not picom: measured 01.10.2026 with tools/compositor-bench, a repainting browser
# window cost Xorg+compositor+Firefox 88 % of a core under our picom.conf and 29-36 % here
# (picom holds the window buffers, so Firefox itself repainted three times dearer). Shadows
# and fades as before; no vsync (Xorg's modesetting has no TearFree), no rules, no unredirect.
xcompmgr -c -C -f -r 14 -o 0.45 -l -14 -t -10 -I 0.06 -O 0.06 -D 8 &
dex -a -s "$HOME/.config/autostart" >/dev/null 2>&1 &

exec i3
