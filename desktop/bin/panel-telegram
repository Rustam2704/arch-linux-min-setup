#!/bin/sh
# Telegram state is rendered by osd-daemon and refreshed when its title changes.
file="${XDG_RUNTIME_DIR:-/tmp}/panel-telegram.txt"
if [ -r "$file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$file"
else
    printf '%s\n' \
        '<css>* { background-color: transparent; background-image: none; box-shadow: none; } button { padding: 0 2px 0 0; }</css>' \
        "<img>$HOME/.local/share/panel-icons/telegram-off.png</img>" \
        '<tool>Telegram is not running</tool>' \
        "<click>$HOME/.local/bin/telegram-toggle</click>" \
        "<txtclick>$HOME/.local/bin/telegram-toggle</txtclick>"
fi
