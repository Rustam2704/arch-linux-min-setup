#!/usr/bin/env python3
"""Telegram for the panel (genmon): its own icon plus the number of unread messages.

Telegram's tray icon is switched off, so this is the only Telegram indicator.
The icon is Telegram's own, from the icon theme; unread messages turn it the
accent colour (see setup/assets/make-telegram-icons.py). The number comes from
the window title, which carries the same count as Telegram's "badge counter"
setting (archived and muted chats excluded when that is off).
"""
import os
import re
import subprocess

import sys
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import THEME, RUN, QUIET, quiet, wrap
ACCENT = THEME["light"]
ICONS = os.path.expanduser("~/.local/share/panel-icons")

title = ""
try:
    out = subprocess.run(["xdotool", "search", "--class", "TelegramDesktop", "getwindowname", "%@"],
                         capture_output=True, text=True, timeout=3).stdout
    title = " ".join(out.split("\n"))
except Exception:
    pass

running = bool(title.strip())
match = re.search(r"\((\d+)\)", title)
count = int(match.group(1)) if match else 0

if not running:
    icon, tip, text = "telegram-off.png", "Telegram is not running", ""
elif count:
    icon = "telegram-accent.png"
    tip = f"Telegram: {count} unread"
    text = f'<span foreground="{ACCENT}" weight="bold">{count}</span>'
else:
    icon, tip, text = "telegram.png", "Telegram: no unread messages", ""

# genmon turns a plugin with a click command into a button, and the theme draws its
# own hover box on it; only the veil deskd holds over the panel should show that.
print('<css>* { background-color: transparent; background-image: none; box-shadow: none; }</css>')
image = os.path.join(ICONS, icon)
if quiet("panel-telegram"):
    # a dimmed copy of the icon, made once per session
    dim = os.path.join(RUN, "quiet-" + icon)
    if not os.path.exists(dim):
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file(image)
        data = bytearray(pb.get_pixels())
        n, stride = pb.get_n_channels(), pb.get_rowstride()
        for y in range(pb.get_height()):
            for x in range(pb.get_width()):
                o = y * stride + x * n
                for k in range(3):
                    data[o + k] = int(data[o + k] * QUIET)
        GdkPixbuf.Pixbuf.new_from_bytes(__import__("gi.repository.GLib", fromlist=["Bytes"]).Bytes.new(bytes(data)),
                                        pb.get_colorspace(), pb.get_has_alpha(), pb.get_bits_per_sample(),
                                        pb.get_width(), pb.get_height(), stride).savev(dim, "png", [], [])
    image = dim
print(f"<img>{image}</img>")
if text:
    print("<txt>" + wrap("panel-telegram", text + " ") + "</txt>")
print(f"<tool>{tip}</tool>")
# clicking the indicator behaves like clicking Telegram's tray icon
print(f"<txtclick>{os.path.expanduser('~/.local/bin/telegram-toggle')}</txtclick>")
