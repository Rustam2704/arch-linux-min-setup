#!/bin/sh
# Keyboard layout for the panel (genmon): EN / RU / UA in the plugin's own font,
# written by osd-daemon as markup padded to one width for every language (the
# font is proportional, and a change of layout must not nudge the neighbours);
# osd-daemon also refreshes this plugin the moment the layout changes.
run="${XDG_RUNTIME_DIR:-/tmp}"
name=$(cat "$run/kbd-layout" 2>/dev/null || echo "--")
markup=$(cat "$run/kbd-layout.markup" 2>/dev/null || echo "<span foreground=\"@COLOUR_MUTED@\">$name</span>")

# genmon turns a plugin with a click command into a button, and the theme draws its
# own hover box on it; only the veil deskd holds over the panel should show that.
echo '<css>* { background-color: transparent; background-image: none; box-shadow: none; }</css>'
echo "<txt>$markup</txt>"
echo "<txtclick>$HOME/.local/bin/osd layout next</txtclick>"
echo "<tool>Keyboard layout: $name
Alt+Shift: English / Russian
Ctrl+Shift: Ukrainian</tool>"
