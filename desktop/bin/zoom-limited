#!/bin/sh
# zoom-limited — Zoom in its own systemd scope with a CPU ceiling and low priority.
# Zoom is used here mostly for audio calls; left alone it took nearly a whole core
# (video decode, gallery rendering). 60 % of one core is plenty for audio and a
# screen share, and CPUWeight/nice make it yield to everything interactive.
# Change the ceiling live:  systemctl --user set-property zoom.scope CPUQuota=100%
if systemctl --user is-active --quiet zoom.scope; then
    exec /usr/bin/zoom "$@"             # already running: hand the link to that instance
fi
exec systemd-run --user --scope --unit=zoom --quiet \
    -p CPUQuota=60% -p CPUWeight=30 --nice=10 \
    /usr/bin/zoom "$@"
