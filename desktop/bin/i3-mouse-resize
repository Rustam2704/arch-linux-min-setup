#!/usr/bin/env python3
"""Super + right-drag anywhere inside a window to resize it (tiled or floating).

With gaps enabled, i3 only resizes tiled windows from a 1-3px border sliver,
which is practically impossible to hit. This follows the pointer while the
right button is held and moves the edge nearest to where you grabbed:
grab in the right half -> right edge follows the mouse, left half -> left edge,
and the same for top/bottom.
"""
import ctypes
import ctypes.util
import json
import subprocess
import time

_x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11"))
_x.XOpenDisplay.restype = ctypes.c_void_p
_x.XOpenDisplay.argtypes = [ctypes.c_char_p]
_x.XDefaultRootWindow.restype = ctypes.c_ulong
_x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
_x.XDisplayWidth.argtypes = _x.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
_x.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 7
_DPY = _x.XOpenDisplay(None)
_ROOT = _x.XDefaultRootWindow(_DPY)
BUTTON3_MASK = 1 << 10


def _query():
    """Pointer position and whether the right button is held, straight from X."""
    root, child = ctypes.c_ulong(), ctypes.c_ulong()
    rx, ry, wx, wy, mask = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_uint()
    _x.XQueryPointer(_DPY, _ROOT, ctypes.byref(root), ctypes.byref(child), ctypes.byref(rx),
                     ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask))
    return rx.value, ry.value, bool(mask.value & BUTTON3_MASK)

INTERVAL = 0.03   # seconds between pointer polls
MIN_PX = 3        # ignore jitter smaller than this


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def pointer():
    x, y, _ = _query()
    return x, y


def button_down():
    return _query()[2]


def leaf_at(tree, x, y):
    """Deepest visible window container whose rect contains (x, y)."""
    visible = {w["name"] for w in json.loads(run("i3-msg", "-t", "get_workspaces")) if w["visible"]}
    found = None

    def walk(node, ws=None):
        nonlocal found
        if node.get("type") == "workspace":
            ws = node.get("name")
        r = node["rect"]
        inside = r["x"] <= x < r["x"] + r["width"] and r["y"] <= y < r["y"] + r["height"]
        if node.get("window") and ws in visible and inside:
            found = node
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child, ws)

    walk(tree)
    return found


def main():
    sw, sh = _x.XDisplayWidth(_DPY, 0), _x.XDisplayHeight(_DPY, 0)
    x0, y0 = pointer()
    tree = json.loads(run("i3-msg", "-t", "get_tree"))
    con = leaf_at(tree, x0, y0)
    if not con:
        return
    cid, r = con["id"], con["rect"]
    subprocess.run(["i3-msg", "-q", f"[con_id={cid}] focus"])

    horiz = "right" if x0 >= r["x"] + r["width"] / 2 else "left"
    vert = "down" if y0 >= r["y"] + r["height"] / 2 else "up"

    lastx, lasty = x0, y0
    while button_down():
        time.sleep(INTERVAL)
        x, y = pointer()
        cmds = []
        dx, dy = x - lastx, y - lasty
        if abs(dx) >= MIN_PX:
            # moving toward the grabbed edge's outside grows, toward the inside shrinks
            outward = dx > 0 if horiz == "right" else dx < 0
            cmds.append(f"resize {'grow' if outward else 'shrink'} {horiz} {abs(dx)} px or {max(1, round(abs(dx) * 100 / sw))} ppt")
            lastx = x
        if abs(dy) >= MIN_PX:
            outward = dy > 0 if vert == "down" else dy < 0
            cmds.append(f"resize {'grow' if outward else 'shrink'} {vert} {abs(dy)} px or {max(1, round(abs(dy) * 100 / sh))} ppt")
            lasty = y
        if cmds:
            subprocess.run(["i3-msg", "-q", f"[con_id={cid}] " + f", ".join(cmds)])


if __name__ == "__main__":
    main()
