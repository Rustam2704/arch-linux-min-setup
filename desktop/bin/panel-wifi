#!/bin/sh
# Wi-Fi fan for the panel (genmon). netqd renders the picture and the markup; this only
# prints them - a shell script, because genmon runs it every few seconds and a Python
# start-up (60 ms of CPU) each time was a steady few percent for nothing.
f="${XDG_RUNTIME_DIR:-/tmp}/netq-wifi.txt"
echo '<css>* { background-color: transparent; background-image: none; box-shadow: none; } button { padding: 0 2px; }</css>'
cat "$f" 2>/dev/null || echo "<txt>Wi-Fi</txt><txtclick>@HOME@/.local/bin/osd menu wifi</txtclick>"
