#!/usr/bin/env python3
"""deskd-favorites — the menu behind the Apple button.

    deskd-favorites              show the menu under the Apple button
    deskd-favorites --login      at login: start favorites if "Launch at login" is on
    deskd-favorites --launch     start all favorites now
    deskd-favorites --i3         regenerate the i3 app -> workspace rules

The menu: a "Launch favorites at login" switch (stays on for every start until
switched off), "Launch all now", the favorite apps as icons (left click includes
or excludes an app, right click picks its workspace or removes it), and "+" to add
an app. Every change is saved at once - there is no Save button.

Everything lives in ~/.config/deskd/apps.conf, readable and editable by hand:

    [settings]
    launch_at_login = false

    [Telegram]
    desktop = org.telegram.desktop.desktop   # or: command = /path/to/program
    class = TelegramDesktop                  # window class, for workspace rules
    workspace = 3                            # empty: no fixed workspace
    enabled = true                           # part of "launch favorites"
"""
import configparser
import json
import os
import shlex
import time
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import css as theme_css  # noqa: E402

CONF = os.path.expanduser("~/.config/deskd/apps.conf")
I3_RULES = os.path.expanduser("~/.config/i3/generated/apps.conf")
APP_DIRS = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"]
WORKSPACES = ["1", "2", "3", "4", "5", "6", "7", "8"]
HEADER = """# deskd favorites: apps for "Launch favorites" and their fixed workspaces.
# Edited by the Apple-button menu (saved instantly) - hand edits are fine too.
#   desktop / command : what to start      class : window class for the workspace rule
#   workspace         : empty = anywhere   enabled : included in "Launch favorites"
"""
DEFAULT = [
    ("Telegram", "org.telegram.desktop.desktop", "TelegramDesktop"),
    ("Firefox", "firefox-developer-edition.desktop", "firefox-developer-edition"),
    ("Sublime Text", "sublime_text.desktop", "Sublime_text"),
    ("kitty", "kitty.desktop", "kitty"),
    ("light-year", "light-year.desktop", "light-year"),
]


# ------------------------------------------------------------------ config
def load():
    cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=("#",))
    cp.optionxform = str
    if not cp.read(CONF):
        cp["settings"] = {"launch_at_login": "false"}
        for name, desktop, cls in DEFAULT:
            cp[name] = {"desktop": desktop, "class": cls, "workspace": "", "enabled": "true"}
        save(cp)
    return cp


def save(cp):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(HEADER + "\n")
        cp.write(f)
    os.replace(tmp, CONF)
    write_i3_rules(cp)


def apps(cp):
    return [s for s in cp.sections() if s != "settings"]


def write_i3_rules(cp):
    lines = ["# Generated by deskd-favorites from ~/.config/deskd/apps.conf - do not edit here."]
    for name in apps(cp):
        a = cp[name]
        ws, cls = a.get("workspace", "").strip(), a.get("class", "").strip()
        if ws and cls:
            esc = cls.replace("\\", "\\\\").replace('"', '\\"')
            # (?i): Firefox reports its class as both firefox-developer-edition and
            # Firefox-developer-edition, and a case-sensitive rule misses one of them
            lines.append(f'assign [class="(?i)^{esc}$"] workspace number {ws}')
    os.makedirs(os.path.dirname(I3_RULES), exist_ok=True)
    old = open(I3_RULES).read() if os.path.exists(I3_RULES) else ""
    new = "\n".join(lines) + "\n"
    if new != old:
        with open(I3_RULES, "w") as f:
            f.write(new)
        subprocess.run(["i3-msg", "-q", "reload"])


# ------------------------------------------------------------------ desktop files
def desktop_path(desktop_id):
    for d in APP_DIRS:
        p = os.path.join(d, desktop_id)
        if os.path.exists(p):
            return p
    return None


def desktop_info(path):
    info = {}
    try:
        in_entry = False
        for line in open(path, encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("["):
                in_entry = line == "[Desktop Entry]"
            elif in_entry and "=" in line:
                k, v = line.split("=", 1)
                info.setdefault(k, v)
    except OSError:
        pass
    return info


def running_classes():
    try:
        tree = json.loads(subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True,
                                         text=True).stdout)
    except ValueError:
        return set()
    found = set()

    def walk(n):
        p = n.get("window_properties")
        if p:
            found.add((p.get("class") or "").lower())
        for c in n.get("nodes", []) + n.get("floating_nodes", []):
            walk(c)
    walk(tree)
    return found


LOG = os.path.expanduser("~/.cache/deskd-favorites.log")


def note(*parts):
    try:
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + " ".join(str(p) for p in parts) + "\n")
    except OSError:
        pass


def exec_command(desktop_id):
    """The Exec line of a .desktop file, without its %-placeholders."""
    path = desktop_path(desktop_id)
    if not path:
        return None
    cmd = desktop_info(path).get("Exec", "")
    return " ".join(w for w in cmd.split() if not w.startswith("%")) or None


def launch(cp, name):
    """Start one favorite through i3, so it belongs to the session and not to this
    short-lived menu process. The command comes from the .desktop file itself:
    gtk-launch goes through D-Bus activation, which failed silently at login."""
    a = cp[name]
    cmd = exec_command(a["desktop"]) if a.get("desktop") else a.get("command")
    if not cmd:
        note("no command for", name)
        return
    res = subprocess.run(["i3-msg", "-q", f"exec --no-startup-id {cmd}"],
                         capture_output=True, text=True)
    note("launch", name, "->", cmd, res.stdout.strip() or res.stderr.strip() or "ok")


def launch_all(cp, stagger=0.0):
    """Start every enabled favorite that is not already open."""
    open_now = running_classes()
    started = 0
    for name in apps(cp):
        a = cp[name]
        if a.get("enabled", "true") != "true":
            continue
        if a.get("class") and a["class"].lower() in open_now:
            note("already running:", name)
            continue
        if started and stagger:
            time.sleep(stagger)       # two cores: starting everything at once thrashes
        launch(cp, name)
        started += 1


# ------------------------------------------------------------------ menu
def menu():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

    cp = load()
    nested = {"open": 0}          # a context menu or file dialog is up: don't close on focus loss
    css = Gtk.CssProvider()
    css.load_from_data(theme_css("""
    .fav { background-color: @COLOUR_BACKGROUND@; color: @COLOUR_FOREGROUND@; border: 1px solid @COLOUR_BORDER@; border-radius: 12px; }
    .fav * { font-family: @FONT@; }
    .fav-title { color: @COLOUR_MUTED@; font-size: 9pt; }
    .fav button { background: @COLOUR_SURFACE@; color: @COLOUR_FOREGROUND@; border: 1px solid @COLOUR_BORDER@; border-radius: 8px;
                  box-shadow: none; text-shadow: none; padding: 4px 10px; }
    .fav button:hover { border-color: @COLOUR_LIGHT@; }
    .fav button.tile { padding: 6px; border-radius: 10px; border-color: transparent; background: transparent; }
    .fav button.tile:hover { background: @COLOUR_SURFACE@; border-color: @COLOUR_BORDER@; }
    .fav button.tile.off { opacity: 0.35; }
    .fav .ws { color: @COLOUR_LIGHT@; font-size: 8pt; font-weight: 700; }
    .fav .name { font-size: 8.5pt; }
    .fav button.add { font-size: 16pt; min-width: 64px; min-height: 64px; color: @COLOUR_MUTED@; }
    """).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    Gdk.set_program_class("deskd-menu")
    win = Gtk.Window(title="Favorites")
    win.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_resizable(False)
    if "--at-pointer" in sys.argv:          # opened from the app menu: appear next to the item
        _, px, py = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
        win.move(px + 16, max(52, py - 24))
    else:
        win.move(10, 52)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, border_width=16)
    outer.get_style_context().add_class("fav")
    win.add(outer)

    # login switch
    row = Gtk.Box(spacing=12)
    row.pack_start(Gtk.Label(label="Launch favorites at login", xalign=0), True, True, 0)
    sw = Gtk.Switch(active=cp["settings"].get("launch_at_login", "false") == "true")

    def on_switch(s, _):
        cp["settings"]["launch_at_login"] = "true" if s.get_active() else "false"
        save(cp)
    sw.connect("notify::active", on_switch)
    row.pack_start(sw, False, False, 0)
    outer.pack_start(row, False, False, 0)

    now = Gtk.Button(label="Launch all now")
    now.connect("clicked", lambda *_: (launch_all(cp), win.destroy()))
    outer.pack_start(now, False, False, 0)

    title = Gtk.Label(label="FAVORITES · click: include / exclude · right click: workspace", xalign=0)
    title.get_style_context().add_class("fav-title")
    outer.pack_start(title, False, False, 2)

    flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=5,
                       min_children_per_line=5, column_spacing=4, row_spacing=4)
    outer.pack_start(flow, False, False, 0)
    theme = Gtk.IconTheme.get_default()

    def icon_for(name):
        a = cp[name]
        icon = "application-x-executable"
        if a.get("desktop"):
            p = desktop_path(a["desktop"])
            icon = desktop_info(p).get("Icon", icon) if p else icon
        size = 48
        try:
            if os.path.isabs(icon):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(icon, size, size)
            else:
                pb = theme.load_icon(icon, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except Exception:
            pb = theme.load_icon("application-x-executable", size, Gtk.IconLookupFlags.FORCE_SIZE)
        return Gtk.Image.new_from_pixbuf(pb)

    def rebuild():
        for c in flow.get_children():
            flow.remove(c)
        for name in apps(cp):
            flow.add(tile(name))
        add = Gtk.Button(label="+", tooltip_text="Add an app")
        add.get_style_context().add_class("add")
        add.connect("clicked", lambda *_: add_app())
        flow.add(add)
        flow.show_all()

    def tile(name):
        a = cp[name]
        b = Gtk.Button(tooltip_text=f"{name}\nLeft click: include / exclude\nRight click: workspace")
        b.get_style_context().add_class("tile")
        if a.get("enabled", "true") != "true":
            b.get_style_context().add_class("off")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        overlay = Gtk.Overlay()
        overlay.add(icon_for(name))
        if a.get("workspace"):
            ws = Gtk.Label(label=a["workspace"], halign=Gtk.Align.END, valign=Gtk.Align.START)
            ws.get_style_context().add_class("ws")
            overlay.add_overlay(ws)
        box.pack_start(overlay, False, False, 0)
        label = Gtk.Label(label=name, max_width_chars=9, ellipsize=3)
        label.get_style_context().add_class("name")
        box.pack_start(label, False, False, 0)
        b.add(box)

        def on_press(w, ev):
            if ev.button == 3:
                options(name, w)
                return True
            return False
        b.connect("button-press-event", on_press)
        b.connect("clicked", lambda *_: toggle(name))
        return b

    def toggle(name):
        a = cp[name]
        a["enabled"] = "false" if a.get("enabled", "true") == "true" else "true"
        save(cp)
        rebuild()

    def options(name, widget):
        m = Gtk.Menu()
        head = Gtk.MenuItem(label=f"{name}: workspace")
        head.set_sensitive(False)
        m.append(head)
        current = cp[name].get("workspace", "")
        for ws in [""] + WORKSPACES:
            item = Gtk.CheckMenuItem(label=ws or "Any workspace", active=(ws == current))
            item.set_draw_as_radio(True)
            item.connect("activate", lambda _i, w=ws: (cp[name].__setitem__("workspace", w), save(cp), rebuild()))
            m.append(item)
        m.append(Gtk.SeparatorMenuItem())
        rm = Gtk.MenuItem(label="Remove from favorites")
        rm.connect("activate", lambda *_: (cp.remove_section(name), save(cp), rebuild()))
        m.append(rm)
        nested["open"] += 1

        def closed(*_):
            nested["open"] -= 1
            GLib.timeout_add(80, grab)
        m.connect("deactivate", closed)
        m.show_all()
        m.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)

    def add_app():
        nested["open"] += 1
        ungrab()
        dlg = Gtk.FileChooserDialog(title="Add an app", transient_for=win,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
        dlg.set_current_folder("/usr/share/applications")
        flt = Gtk.FileFilter()
        flt.set_name("Apps (.desktop) and programs")
        flt.add_pattern("*.desktop")
        flt.add_mime_type("application/x-executable")
        flt.add_mime_type("application/x-shellscript")
        flt.add_mime_type("application/x-sharedlib")
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            if path.endswith(".desktop"):
                info = desktop_info(path)
                name = info.get("Name", os.path.basename(path)[:-8])
                entry = {"desktop": os.path.basename(path),
                         "class": info.get("StartupWMClass", ""), "workspace": "", "enabled": "true"}
            else:
                name = os.path.basename(path)
                entry = {"command": path, "class": "", "workspace": "", "enabled": "true"}
            base, n = name, 2
            while cp.has_section(name):
                name, n = f"{base} {n}", n + 1
            cp[name] = entry
            save(cp)
            rebuild()
        dlg.destroy()
        nested["open"] -= 1
        win.present()
        GLib.timeout_add(80, grab)

    rebuild()
    all_apps = Gtk.Button(label="All applications…")
    all_apps.connect("clicked", lambda *_: (subprocess.Popen(
        [os.path.expanduser("~/.local/bin/rofi-toggle"), "drun"], start_new_session=True), win.destroy()))
    outer.pack_start(all_apps, False, False, 0)

    seat = Gdk.Display.get_default().get_default_seat()

    tries = {"n": 0}

    def grab():
        """Like a real menu: take pointer + keyboard, so a click anywhere else closes it.
        Right after opening, the button that opened us (panel, app menu) may still hold
        the pointer; then the grab fails - keep trying for a couple of seconds."""
        if nested["open"] or not win.get_window():
            return False
        status = seat.grab(win.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None)
        if status != Gdk.GrabStatus.SUCCESS and tries["n"] < 40:
            tries["n"] += 1
            GLib.timeout_add(50, grab)
        else:
            tries["n"] = 0
        return False

    def ungrab():
        seat.ungrab()

    def on_button(w, ev):
        alloc = win.get_allocation()
        if ev.window == win.get_window() and not (0 <= ev.x <= alloc.width and 0 <= ev.y <= alloc.height):
            win.destroy()
            return True
        return False
    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    win.connect("button-press-event", on_button)
    win.connect("map-event", lambda *_: GLib.timeout_add(50, grab) and False)
    win.connect("key-press-event", lambda w, ev: ev.keyval == Gdk.KEY_Escape and (win.destroy() or True))
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.present()
    Gtk.main()


if __name__ == "__main__":
    if "--login" in sys.argv:
        cp = load()
        if cp["settings"].get("launch_at_login", "false") == "true":
            note("login: launching favorites")
            launch_all(cp, stagger=1.5)
    elif "--launch" in sys.argv:
        launch_all(load())
    elif "--i3" in sys.argv:
        write_i3_rules(load())
    else:
        menu()
