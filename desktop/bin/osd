#!/usr/bin/env python3
# osd — send a command to the on-screen display daemon (osd.service).
#   osd vol up|down|mute   osd bright up|down   osd layout next|show   osd menu wifi|info
import errno
import os
import stat
import subprocess
import sys
import time

fifo = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "osd.fifo")
message = (" ".join(sys.argv[1:]) + "\n").encode()
for attempt in range(12):
    try:
        if not stat.S_ISFIFO(os.stat(fifo, follow_symlinks=False).st_mode):
            raise OSError(errno.ENXIO, "OSD endpoint is not a FIFO")
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, message)
        finally:
            os.close(fd)
        break
    except OSError as error:
        if error.errno not in (errno.ENOENT, errno.ENXIO):
            raise
        if attempt == 0:
            try:
                subprocess.run(["systemctl", "--user", "start", "osd.service"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                pass
        time.sleep(0.1)
