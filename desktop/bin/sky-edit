#!/usr/bin/env python3
"""Native, automatically saved editor for a CLI's external-editor protocol."""
import os
from pathlib import Path
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import THEME

path = Path(sys.argv[-1])
window = Gtk.Window(title="Edit message")
window.set_default_size(900, 540)
window.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=16)
window.add(box)
help_label = Gtk.Label(label="Ctrl+A: select all · Shift+arrows: select · Close or Ctrl+Enter: return to chat", xalign=0)
box.pack_start(help_label, False, False, 0)
view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=12, right_margin=12, top_margin=12, bottom_margin=12)
buffer = view.get_buffer()
buffer.set_text(path.read_text())
scroll = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
scroll.add(view)
box.pack_start(scroll, True, True, 0)
status = Gtk.Label(label="Changes are saved automatically", xalign=0)
box.pack_start(status, False, False, 0)
provider = Gtk.CssProvider()
provider.load_from_data(f'window, textview, textview text {{ background: {THEME["background"]}; color: {THEME["foreground"]}; font: 12pt {THEME["font"]}; }} textview text selection {{ background: {THEME["accent"]}; }}'.encode())
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
pending = None


def save(*_):
    global pending
    if pending is not None:
        GLib.source_remove(pending)
        pending = None
    try:
        path.write_text(buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True))
        status.set_text("Saved · Close to return to chat")
        return True
    except OSError as error:
        status.set_text(str(error))
        return False


def changed(*_):
    global pending
    if pending is not None:
        GLib.source_remove(pending)
    pending = GLib.timeout_add(150, lambda: (save(), False)[1])


def close(*_):
    if save():
        Gtk.main_quit()
    return True


def key(_, event):
    if event.keyval == Gdk.KEY_Return and event.state & Gdk.ModifierType.CONTROL_MASK:
        close()
        return True
    return False


buffer.connect("changed", changed)
window.connect("delete-event", close)
window.connect("key-press-event", key)
window.show_all()
view.grab_focus()
Gtk.main()
