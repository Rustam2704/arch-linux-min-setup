#!/usr/bin/env python3
"""net-menu --wifi | --info | --speedtest: the network menus (see netmenu.py in the
shared library). The menus are popped up by osd-daemon, which keeps them warm; this
command only asks it - and runs the menu itself when the daemon is not there."""
import os
import sys

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
FIFO = os.path.join(RUN, "osd.fifo")
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))


def main():
    if "--speedtest" in sys.argv:
        import netmenu
        netmenu.speedtest()
        return
    which = "info" if "--info" in sys.argv else "wifi"
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)     # a reader must be there
        os.write(fd, f"menu {which}\n".encode())
        os.close(fd)
        return
    except OSError:
        pass
    import netmenu
    netmenu.menu(wifi_only=which == "wifi")


if __name__ == "__main__":
    main()
