#!/usr/bin/env python3
"""CPU and memory for the panel (genmon).

Deliberately plain numbers: load since the previous update, memory that is
actually unavailable (MemAvailable, not "used"), and swap only when something
is in it.
"""
import os

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "panel-sys.state")
import sys
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import THEME, GAP, icon

ACCENT = THEME["light"]
DIM = THEME["muted"]
WARN = THEME["warning"]
CRIT = THEME["danger"]
GAP = '<span size="50%"> </span>'      # half a space: a word and its number belong together


def cpu_percent():
    with open("/proc/stat") as f:
        parts = [int(x) for x in f.readline().split()[1:]]
    idle, total = parts[3] + parts[4], sum(parts)
    prev_idle = prev_total = 0
    try:
        with open(STATE) as f:
            prev_idle, prev_total = (int(x) for x in f.read().split())
    except (OSError, ValueError):
        pass
    with open(STATE, "w") as f:
        f.write(f"{idle} {total}")
    d_total = total - prev_total
    d_idle = idle - prev_idle
    if d_total <= 0:
        return 0
    return max(0, min(100, round(100 * (d_total - d_idle) / d_total)))


def meminfo():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
    total = info["MemTotal"]
    used = total - info.get("MemAvailable", info["MemFree"])
    swap_total = info.get("SwapTotal", 0)
    swap_used = swap_total - info.get("SwapFree", 0)
    return round(100 * used / total), used // 1024, total // 1024, swap_used // 1024


def colour(pct):
    return CRIT if pct >= 90 else WARN if pct >= 75 else ACCENT


cpu = cpu_percent()
mem_pct, mem_used, mem_total, swap_used = meminfo()

def value(text, colour, width, suffix=""):
    """A cell exactly `width` digits wide with the number against its right edge, so
    a new order of magnitude fills the space that was already reserved instead of
    shoving the reading sideways. The filler is transparent zeroes, not spaces:
    Pango and genmon drop stray whitespace but keep real (tabular) glyphs."""
    room = "0" * max(0, width - len(text))
    return (f'<span foreground="{colour}"><span alpha="1">{room}</span>'
            f'{text}{suffix}</span>')


def panel_percent(pct):
    """Two digit positions; 100 and above roll over to 00, as asked."""
    return "00" if pct >= 100 else str(pct)


# One letter and the number, no units: the panel is narrow and the letter says
# which reading it is. Swap is whole gigabytes.
parts = [f'{value(panel_percent(cpu), colour(cpu), 2)}{GAP}{icon("cpu")}',
         f'{value(panel_percent(mem_pct), colour(mem_pct), 2)}{GAP}{icon("memory")}']
if swap_used > 64:
    # one digit: 10 GB and above roll over to 0-6 in red, the way the user asked
    swap_gb = max(1, round(swap_used / 1024))
    swap_txt, swap_colour = (str(swap_gb - 10), THEME["danger"]) if swap_gb >= 10 else (str(swap_gb), THEME["text"])
    parts.append(f'{value(swap_txt, swap_colour, 1)}{GAP}{icon("swap")}')

# genmon turns a plugin with a click command into a button, and the theme draws its
# own hover box on it; only the veil deskd holds over the panel should show that.
print('<css>* { background-color: transparent; background-image: none; box-shadow: none; }</css>')
# a space on both sides: the gap to the separator matches the one the weather glyph keeps
print('<txt><span font_features="tnum"> ' + "  ".join(parts) + " </span></txt>")
print(f"<tool>CPU: {cpu}%\nMemory: {mem_used} of {mem_total} MB ({mem_pct}%)\n"
      f"Swap: {swap_used} MB (on SSD)</tool>")
