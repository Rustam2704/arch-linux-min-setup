#!/bin/sh
# CPU genmon reader. sysqd prepares markup and SVG every two seconds.
echo '<css>* { background-color: transparent; background-image: none; box-shadow: none; margin: 0; padding: 0; } button { margin: 0; padding: 0; }</css>'
cat "${XDG_RUNTIME_DIR:-/tmp}/sysq-cpu.txt" 2>/dev/null || echo '<txt>CPU</txt>'
