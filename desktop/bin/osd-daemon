#!/usr/bin/env python3
"""On-screen display + keyboard layout switcher for the i3 session.

OSD: an override-redirect window (so it shows above fullscreen video) in the top
right corner, fixed size so it never jumps while the value changes, 90% opaque.

Commands arrive on a FIFO (see the `osd` client):
    vol up | vol down | vol mute     change the default sink and show it
                                     (any volume change also unmutes)
    bright up | bright down          screen brightness
    menu wifi | menu info | menu audio   pop up the menus (panel clicks; audio toggles)
    layout next                      EN <-> RU (same as Alt+Shift)
    layout show                      flash the current layout

Layouts (Windows-style, switched on key RELEASE so Ctrl+Shift+V etc. keep working):
    Alt+Shift    from UA -> EN, otherwise EN <-> RU
    Ctrl+Shift   UA; pressed again on UA -> back to the previous layout
The current layout name is written to $XDG_RUNTIME_DIR/kbd-layout for the panel.
"""
import ctypes
import json
import os
import queue
import re
import subprocess
import threading
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
FIFO = os.path.join(RUN, "osd.fifo")
LAYOUT_FILE = os.path.join(RUN, "kbd-layout")
LAYOUT_MARKUP = LAYOUT_FILE + ".markup"   # what panel-layout shows: padded to one width
HIDE_MS = 1100
MARGIN_TOP = 56          # one-row 44px panel + gap
MARGIN_RIGHT = 24
import sys
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import THEME, css  # noqa: E402
import sky_text  # noqa: E402
import xfpanel  # noqa: E402
import netmenu  # noqa: E402  (imported now: the menus must pop up warm)
import audiomenu  # noqa: E402
import powermenu  # noqa: E402
ACCENT = THEME["light"]
PANEL_FONT_FAMILY = THEME["panel_font"].rsplit(" ", 1)[0]   # the badge is set in the panel font
OVER = THEME["warning"]     # above 100%
LAYOUT_COLOURS = THEME["layouts"]   # one colour per language, the same as in the panel
VOL_STEP = 5
VOL_LIMIT = 150            # percent; the bar shows "over" above 100

GLYPH = {
    "vol-high": "", "vol-low": "", "vol-mute": "\U000f075f",
    "bright": "",
}

CSS = css("""
window { background: transparent; }
#osd {
    background-color: @COLOUR_BACKGROUND@;
    border: 1px solid rgba(@RGB_LIGHT@, 0.35);
    border-radius: 12px;
    padding: 10px 16px;
}
#osd label { color: @COLOUR_FOREGROUND@; font-family: @FONT@; font-size: 15px; font-weight: 600;
             font-feature-settings: "tnum"; }
#osd label.glyph { font-family: "@MONO_FONT@"; font-size: 19px; color: @COLOUR_LIGHT@; }
#osd label.badge { font-family: "PANEL_FONT_FAMILY"; font-size: 48px; font-weight: 400; color: @COLOUR_LIGHT@; letter-spacing: 4px; }
#osd.badge-mode { padding: 20px 32px; border-radius: 24px; border-width: 2px; }
#osd label.value { color: @COLOUR_LIGHT@; }
#osd.over label.value, #osd.over label.glyph { color: @COLOUR_WARNING@; }
#osd.muted label.value, #osd.muted label.glyph { color: @COLOUR_MUTED@; }
#osd.layout-en { border-color: @COLOUR_LAYOUTS_EN@; }
#osd.layout-ru { border-color: @COLOUR_LAYOUTS_RU@; }
#osd.layout-ua { border-color: @COLOUR_LAYOUTS_UA@; }
progressbar trough { min-height: 6px; min-width: 190px; background-color: rgba(255,255,255,0.14);
                     border: none; border-radius: 3px; }
progressbar progress { min-height: 6px; background-color: @COLOUR_LIGHT@; border: none; border-radius: 3px; }
#osd.over progressbar progress { background-color: @COLOUR_WARNING@; }
#osd.muted progressbar progress { background-color: @COLOUR_DIM@; }
""".replace("PANEL_FONT_FAMILY", PANEL_FONT_FAMILY)).encode()


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return ""


# ---------------------------------------------------------------- OSD window
class Osd(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)   # override-redirect: above fullscreen
        self.set_app_paintable(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_opacity(0.90)  # deprecated in GTK3 docs, still the only way for a whole-window alpha

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.box.set_name("osd")
        self.icon = Gtk.Label(width_chars=2)
        self.bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
        self.value = Gtk.Label(width_chars=5, xalign=1.0)   # "100%", "150%", "muted" never resize
        self.value.get_style_context().add_class("value")
        self.box.pack_start(self.icon, False, False, 0)
        self.box.pack_start(self.bar, True, True, 0)
        self.box.pack_start(self.value, False, False, 0)
        self.add(self.box)
        self.box.show_all()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.timer = None
        self.mode = None
        self.monitor_geo = None
        self.badge_width = None

    def _place(self, mode):
        display = Gdk.Display.get_default()
        _, px, py = display.get_default_seat().get_pointer().get_position()
        monitor = display.get_monitor_at_point(px, py) or display.get_monitor(0)
        geo = monitor.get_geometry()
        key = (mode, geo.x, geo.y, geo.width, geo.height)
        if key == self.monitor_geo:
            return                          # same mode, same screen: never move
        self.monitor_geo = key
        self.resize(1, 1)
        size = self.get_preferred_size().natural_size
        if mode == "badge":                  # the layout: in the middle of the screen, big
            self.move(geo.x + (geo.width - size.width) // 2, geo.y + (geo.height - size.height) // 2)
        else:
            self.move(geo.x + geo.width - size.width - MARGIN_RIGHT, geo.y + MARGIN_TOP)

    def _set_state(self, *classes):
        ctx = self.box.get_style_context()
        for c in ("over", "muted", "layout-en", "layout-ru", "layout-ua"):
            (ctx.add_class if c in classes else ctx.remove_class)(c)

    def level(self, glyph, percent, muted=False):
        ctx = self.icon.get_style_context()
        ctx.remove_class("badge")
        ctx.add_class("glyph")
        self.box.get_style_context().remove_class("badge-mode")
        self.icon.set_size_request(-1, -1)
        self.icon.set_text(glyph)
        self.bar.show()
        self.value.show()
        self.bar.set_fraction(max(0.0, min(1.0, percent / 100.0)))
        self.value.set_text("muted" if muted else f"{percent}%")
        self._set_state(*(["muted"] if muted else (["over"] if percent > 100 else [])))
        self._show("level")

    def badge(self, text):
        ctx = self.icon.get_style_context()
        ctx.remove_class("glyph")
        ctx.add_class("badge")
        self.box.get_style_context().add_class("badge-mode")
        colour = LAYOUT_COLOURS.get(text, ACCENT)
        if self.badge_width is None:
            # one size for every language: the widest name sets the label's width,
            # so the UA badge is the same box as EN and RU (Inter is proportional)
            widths = []
            for name in LAYOUT_COLOURS:
                self.icon.set_text(name)
                widths.append(self.icon.get_preferred_width()[1])
            self.badge_width = max(widths)
        self.icon.set_size_request(self.badge_width, -1)
        self.icon.set_markup(f'<span foreground="{colour}">{text}</span>')
        self.bar.hide()
        self.value.hide()
        self._set_state("layout-" + text.lower() if text in LAYOUT_COLOURS else "")
        self._show("badge")

    def _show(self, mode):
        self._place(mode)
        self.show()
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(HIDE_MS, self._dismiss)

    def _dismiss(self):
        self.hide()
        self.timer = None
        return False


# ---------------------------------------------------------------- audio / brightness
_vol = {"v": None, "muted": False, "t": 0.0}


def volume_state():
    """(percent, muted) from pactl - about 20 ms a call, half of what wpctl costs."""
    out = run("pactl", "get-sink-volume", "@DEFAULT_SINK@")   # Volume: front-left: 29491 /  45% / ...
    m = re.search(r"(\d+)%", out)
    v = int(m.group(1)) if m else 0
    muted = "yes" in run("pactl", "get-sink-mute", "@DEFAULT_SINK@")
    _vol.update(v=v, muted=muted, t=time.monotonic())
    return v, muted


def show_volume(osd, v, muted):
    glyph = GLYPH["vol-mute"] if muted or v == 0 else GLYPH["vol-high" if v >= 50 else "vol-low"]
    GLib.idle_add(osd.level, glyph, v, muted)


def do_volume(osd, arg):
    sink = "@DEFAULT_SINK@"
    if arg == "mute":
        run("pactl", "set-sink-mute", sink, "toggle")
    else:
        if _vol["v"] is None or time.monotonic() - _vol["t"] > 5:
            volume_state()
        v = max(0, min(VOL_LIMIT, _vol["v"] + (VOL_STEP if arg == "up" else -VOL_STEP)))
        # the OSD moves first, then the sink: the key feels instant, and a held
        # key runs at the cost of two pactl calls per step
        show_volume(osd, v, False)
        _vol.update(v=v, muted=False, t=time.monotonic())
        run("pactl", "set-sink-mute", sink, "0")          # any change unmutes
        run("pactl", "set-sink-volume", sink, f"{v}%")
        return
    show_volume(osd, *volume_state())


def do_brightness(osd, arg):
    if arg in ("up", "down"):
        run("brightnessctl", "-q", "set", "5%+" if arg == "up" else "5%-")
    out = run("brightnessctl", "-m")                  # name,class,raw,NN%,max
    try:
        v = int(out.split(",")[3].rstrip("%\n"))
    except (IndexError, ValueError):
        v = 0
    GLib.idle_add(osd.level, GLYPH["bright"], v)


# ---------------------------------------------------------------- keyboard layouts
class Xkb:
    """Tiny ctypes wrapper: read and lock the XKB group (= layout index)."""
    class State(ctypes.Structure):
        _fields_ = [("group", ctypes.c_ubyte), ("locked_group", ctypes.c_ubyte),
                    ("base_group", ctypes.c_ushort), ("latched_group", ctypes.c_short),
                    ("mods", ctypes.c_ubyte), ("base_mods", ctypes.c_ubyte),
                    ("latched_mods", ctypes.c_ubyte), ("locked_mods", ctypes.c_ubyte),
                    ("compat_state", ctypes.c_ubyte), ("grab_mods", ctypes.c_ubyte),
                    ("compat_grab_mods", ctypes.c_ubyte), ("lookup_mods", ctypes.c_ubyte),
                    ("compat_lookup_mods", ctypes.c_ubyte), ("ptr_buttons", ctypes.c_ushort)]
    USE_CORE_KBD = 0x0100

    def __init__(self):
        self.x = ctypes.cdll.LoadLibrary("libX11.so.6")
        self.x.XOpenDisplay.restype = ctypes.c_void_p
        self.x.XkbGetState.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(self.State)]
        self.x.XkbLockGroup.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
        self.x.XFlush.argtypes = [ctypes.c_void_p]
        self.dpy = self.x.XOpenDisplay(None)
        self.lock = threading.Lock()

    def group(self):
        st = self.State()
        with self.lock:
            self.x.XkbGetState(self.dpy, self.USE_CORE_KBD, ctypes.byref(st))
        return st.group

    def set_group(self, g):
        with self.lock:
            self.x.XkbLockGroup(self.dpy, self.USE_CORE_KBD, g)
            self.x.XFlush(self.dpy)


class Chords:
    """The modifier chords, Windows-style: Alt+Shift or Ctrl+Shift fires when one of
    its keys is released and nothing else was pressed since the chord began. Pure
    state, fed by the XRecord watcher, so the sequences can be tested without a
    keyboard (tests/test_chords.py)."""
    def __init__(self, cats, held=lambda: None):
        self.cats = cats            # keycode -> "shift" / "alt" / "ctrl" / "super" / "altgr"
        self.down = {}              # keycode -> category of every modifier now held
        self.dirty = False          # something else was pressed during this chord
        self.held = held            # () -> keycodes really down (XQueryKeymap), or None

    def press(self, kc):
        cat = self.cats.get(kc)
        if cat is None:
            self.dirty = True
            return
        real = self.held()
        if real is not None:        # a release the watcher never saw (suspend, VT switch,
            for k in list(self.down):   # a grab): forget it, or no chord ever matches again
                if k not in real:
                    del self.down[k]
        if not self.down:
            # a new chord starts clean: a letter still held from typing (fast typing
            # overlaps keys) must not spoil the Alt+Shift right after it
            self.dirty = False
        self.down[kc] = cat

    def button(self):
        self.dirty = True

    def release(self, kc):
        """The chord that completes with this release, or None."""
        combo = None
        if kc in self.down:
            held = set(self.down.values())
            if not self.dirty:
                if held == {"alt", "shift"}:
                    combo = "alt_shift"
                elif held == {"ctrl", "shift"}:
                    combo = "ctrl_shift"
                if combo:
                    self.dirty = True       # the other key's release must not fire it again
            del self.down[kc]
        if not self.down:
            self.dirty = False
        return combo


def thunar_folder(local):
    """The folder shown by the focused Thunar window, or None. Thunar is set to put
    the full path into the title ("/home/me/Pictures - Thunar": xfconf thunar
    /misc-window-title-style = full path with suffix), the only place it tells."""
    try:
        root = local.screen().root
        win = local.get_input_focus().focus
        cls = title = None
        while win and win != root:                # up to the top-level window
            if cls is None:
                cls = win.get_wm_class()
            if title is None:
                name = win.get_full_property(local.intern_atom("_NET_WM_NAME"), 0)
                if name and name.value:
                    title = name.value.decode(errors="replace") if isinstance(name.value, bytes) else str(name.value)
            if cls and title:
                break
            win = win.query_tree().parent
    except Exception:                             # noqa: BLE001 - no window, no folder
        return None
    if not cls or cls[1] != "Thunar" or not title or not title.endswith(" - Thunar"):
        return None
    folder = title[:-len(" - Thunar")]
    return folder if os.path.isdir(folder) else None


def layout_names():
    """['EN', 'RU', 'UA'] in XKB group order, from the live keymap."""
    names = []
    for line in run("setxkbmap", "-query").splitlines():
        if line.startswith("layout:"):
            names = [n.strip() for n in line.split(":", 1)[1].split(",")]
    return [{"us": "EN", "gb": "EN"}.get(n, n.upper()) for n in names] or ["EN"]


class Sounds:
    """A few short sounds, decoded once, played through libpulse-simple (PipeWire's
    Pulse server) without any helper process. One stream serves a whole burst of
    presses: written in 40 ms chunks, so a new press (of any of the sounds) flushes
    what is queued and starts over within 40 ms; the stream closes after the last
    chunk drained, and the card is free to sleep again."""
    def __init__(self, files):
        import wave
        self.pcm = {}
        self.rate = self.channels = None
        for name, path in files.items():
            try:
                with wave.open(path, "rb") as w:
                    assert w.getsampwidth() == 2
                    if self.rate is None:
                        self.rate, self.channels = w.getframerate(), w.getnchannels()
                    assert (w.getframerate(), w.getnchannels()) == (self.rate, self.channels)
                    self.pcm[name] = w.readframes(w.getnframes())
            except (OSError, wave.Error, AssertionError) as e:
                print("osd: sound not loaded:", path, e, flush=True)
        self.pa = None
        self.lock = threading.Lock()
        self.running = False        # a burst thread owns the stream (set and cleared under the lock)
        self.next = None

    def play(self, name):
        if name not in self.pcm:
            return
        with self.lock:
            self.next = name
            if not self.running:
                self.running = True
                threading.Thread(target=self._run, daemon=True).start()

    def _lib(self):
        if self.pa is None:
            lib = ctypes.CDLL("libpulse-simple.so.0")
            lib.pa_simple_new.restype = ctypes.c_void_p
            lib.pa_simple_new.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
                                          ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
                                          ctypes.c_void_p]
            lib.pa_simple_write.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
            lib.pa_simple_drain.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            lib.pa_simple_flush.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            lib.pa_simple_free.argtypes = [ctypes.c_void_p]
            self.pa = lib
        return self.pa

    def _run(self):
        try:
            lib = self._lib()

            class Spec(ctypes.Structure):
                _fields_ = [("format", ctypes.c_int), ("rate", ctypes.c_uint32), ("channels", ctypes.c_uint8)]
            spec = Spec(3, self.rate, self.channels)       # 3 = PA_SAMPLE_S16LE
            chunk = int(self.rate * self.channels * 2 * 0.04)

            class Attr(ctypes.Structure):
                _fields_ = [(n, ctypes.c_uint32) for n in ("maxlength", "tlength", "prebuf", "minreq", "fragsize")]
            # a two-chunk buffer, no prebuffering: the sound starts on the first write and
            # a restart (flush) is heard within one chunk, not after a default-sized queue
            attr = Attr(0xFFFFFFFF, chunk * 2, 0, 0xFFFFFFFF, 0xFFFFFFFF)
            err = ctypes.c_int(0)
            stream = lib.pa_simple_new(None, b"sky-desktop", 1, None, b"key",   # 1 = playback
                                       ctypes.byref(spec), None, ctypes.byref(attr), ctypes.byref(err))
            if not stream:
                return
            pcm, pos = b"", 0
            while True:
                with self.lock:
                    if self.next is not None:
                        pcm, pos = self.pcm[self.next], 0
                        self.next = None
                        lib.pa_simple_flush(stream, ctypes.byref(err))
                if pos >= len(pcm):
                    lib.pa_simple_drain(stream, ctypes.byref(err))
                    with self.lock:                # a press during the drain: play on
                        if self.next is None:
                            self.running = False
                            break
                    continue
                lib.pa_simple_write(stream, pcm[pos:pos + chunk], min(chunk, len(pcm) - pos), ctypes.byref(err))
                pos += chunk
            lib.pa_simple_free(stream)
        except Exception as e:                     # noqa: BLE001 - a sound is never worth a crash
            print("osd: sound failed:", e, flush=True)
        finally:
            with self.lock:
                self.running = False


SOUNDS = Sounds({name: os.path.expanduser(f"~/.local/share/sky-desktop/sounds/{name}.wav") for name in ("accept", "move")})
KEYSOUND = os.path.expanduser("~/.config/sky-desktop/keysound")   # "off" silences Enter (audio-menu)
AUDIO_STATE = os.path.join(RUN, "audio.json")


def keysound_on():
    try:
        with open(KEYSOUND) as f:
            return f.read().strip() != "off"
    except OSError:
        return True


def watch_audio():
    """`pactl subscribe` says when a volume, a mute or a recording changes; the state
    goes to AUDIO_STATE for panel-audio, which is then asked to redraw. No polling."""
    def pactl(*a):
        try:
            return subprocess.run(["pactl", *a], capture_output=True, text=True, timeout=3).stdout
        except OSError:
            return ""

    def percent(out):
        m = re.search(r"(\d+)%", out)
        return int(m.group(1)) if m else 0

    last = None

    def publish():
        nonlocal last
        state = {"volume": percent(pactl("get-sink-volume", "@DEFAULT_SINK@")),
                 "muted": "yes" in pactl("get-sink-mute", "@DEFAULT_SINK@"),
                 "mic": percent(pactl("get-source-volume", "@DEFAULT_SOURCE@")),
                 "mic_muted": "yes" in pactl("get-source-mute", "@DEFAULT_SOURCE@"),
                 # a recording = a client's stream on a source; module streams (the echo
                 # canceller's own capture) have no client and do not count
                 "recording": any(line.split("\t")[2:3] not in ([], ["-"])
                                  for line in pactl("list", "source-outputs", "short").splitlines() if line.strip())}
        if state == last:
            return
        last = state
        try:
            with open(AUDIO_STATE + ".tmp", "w") as f:
                json.dump(state, f)
            os.replace(AUDIO_STATE + ".tmp", AUDIO_STATE)
        except OSError:
            return
        xfpanel.refresh("panel-audio")

    publish()
    while True:
        try:
            proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
            pending = False
            for line in proc.stdout:
                if not any(k in line for k in ("on sink", "on source", "on source-output", "on server")):
                    continue
                # events come in bursts: settle for 150 ms, then read once
                pending = True
                while pending:
                    proc.stdout.flush()
                    time.sleep(0.15)
                    pending = False
                publish()
        except OSError as e:
            print("osd: pactl subscribe failed:", e, flush=True)
        time.sleep(5)                       # the sound server restarted: try again


class Layouts:
    def __init__(self, osd):
        self.osd = osd
        self.xkb = Xkb()
        self.names = layout_names()
        self.current = self.xkb.group()
        self.previous = 0
        self.changed_at = 0.0          # our own switch; the external watcher waits it out
        self.publish(show=False)

    def idx(self, name):
        return self.names.index(name) if name in self.names else None

    def publish(self, show=True):
        name = self.names[self.current] if self.current < len(self.names) else "?"
        try:
            with open(LAYOUT_FILE + ".tmp", "w") as f:
                f.write(name)
            os.replace(LAYOUT_FILE + ".tmp", LAYOUT_FILE)
            with open(LAYOUT_MARKUP + ".tmp", "w") as f:
                f.write(self.panel_markup(name))
            os.replace(LAYOUT_MARKUP + ".tmp", LAYOUT_MARKUP)
        except OSError:
            pass
        xfpanel.refresh("panel-layout")
        if show:
            GLib.idle_add(self.osd.badge, name)

    def panel_markup(self, name):
        """The code in its colour, padded to the width of the widest one: the panel
        font is proportional, and a change of layout must not nudge its neighbours."""
        font = sky_text.panel_font(PANEL_LAYOUT_PLUGIN.split("-")[1])
        widest = max(sky_text.width(n, font) for n in self.names)
        colour = LAYOUT_COLOURS.get(name, THEME["muted"])
        return sky_text.pad_to(f'<span foreground="{colour}">{name}</span>', widest, font, align="center", after="")

    def switch(self, g):
        if g is None or g == self.current:
            return
        if self.names[self.current] != "UA":
            self.previous = self.current
        self.changed_at = time.monotonic()
        self.xkb.set_group(g)
        self.current = g
        self.publish()

    def alt_shift(self):
        en, ru = self.idx("EN"), self.idx("RU")
        cur = self.names[self.current]
        if cur == "EN" and ru is not None:
            self.switch(ru)
        else:
            self.switch(en if en is not None else 0)

    def ctrl_shift(self):
        ua = self.idx("UA")
        if ua is None:
            return
        self.switch(self.previous if self.current == ua else ua)

    def watch_external(self):
        """Something else changed the layout (panel click, xkb option): follow it."""
        seen = None
        while True:
            time.sleep(0.3)
            g = self.xkb.group()
            if g == self.current or time.monotonic() - self.changed_at < 0.8:
                seen = None
                continue
            if seen != g:              # must hold for two polls in a row
                seen = g
                continue
            seen = None
            if True:
                if self.current < len(self.names) and self.names[self.current] != "UA":
                    self.previous = self.current
                self.current = g
                self.publish()

    def watch_keys(self):
        """Windows-style: the combo fires when a modifier is released and nothing
        else was pressed in between. XRecord only observes, it never grabs keys."""
        from Xlib import X, XK, display
        from Xlib.ext import record
        from Xlib.protocol import rq

        rec = display.Display()
        local = display.Display()
        cats = {}
        for sym, cat in (("Shift_L", "shift"), ("Shift_R", "shift"), ("Control_L", "ctrl"),
                         ("Control_R", "ctrl"), ("Alt_L", "alt"), ("Alt_R", "alt"),
                         ("Meta_L", "alt"), ("Meta_R", "alt"), ("Super_L", "super"),
                         ("Super_R", "super"), ("ISO_Level3_Shift", "altgr")):
            for kc, _ in local.keysym_to_keycodes(XK.string_to_keysym(sym)):
                cats[kc] = cat

        def really_down():
            keys = local.query_keymap()
            return {kc for kc in range(256) if keys[kc >> 3] & (1 << (kc & 7))}
        chords = Chords(cats, really_down)
        state = {"key_up": -1000}
        enter = {kc for sym in ("Return", "KP_Enter") for kc, _ in local.keysym_to_keycodes(XK.string_to_keysym(sym))}
        arrows = {kc for sym in ("Left", "Right", "Up", "Down", "KP_Left", "KP_Right", "KP_Up", "KP_Down")
                  for kc, _ in local.keysym_to_keycodes(XK.string_to_keysym(sym))}
        keyed = enter | arrows
        paste = {kc for kc, _ in local.keysym_to_keycodes(XK.string_to_keysym("v"))}   # the V key, any layout
        def handler(reply):
            data = reply.data
            while len(data):
                ev, data = rq.EventField(None).parse_binary_value(data, rec.display, None, None)
                if ev.type in (X.ButtonPress,):
                    chords.button()
                    continue
                kc = ev.detail
                if ev.type == X.KeyPress:
                    if kc in keyed:
                        # autorepeat is a release/press pair stamped with the same server
                        # time; a real tap, however fast, has tens of ms between them
                        if ev.time - state["key_up"] > 8 and keysound_on():
                            SOUNDS.play("accept" if kc in enter else "move")
                    chords.press(kc)
                    if kc in paste and set(chords.down.values()) == {"ctrl"}:
                        folder = thunar_folder(local)
                        if folder:
                            # Ctrl+V in Thunar with an image on the clipboard: Thunar's own
                            # paste knows only files, and its custom-action shortcuts match the
                            # keyval (so not on RU/UA) - the keycode is watched here instead
                            threading.Thread(target=run, daemon=True,
                                             args=(os.path.expanduser("~/.local/bin/paste-image"), folder)).start()
                elif ev.type == X.KeyRelease:
                    if kc in keyed:
                        state["key_up"] = ev.time
                    combo = chords.release(kc)
                    if combo == "alt_shift":
                        self.alt_shift()
                    elif combo == "ctrl_shift":
                        self.ctrl_shift()

        ctx = rec.record_create_context(0, [record.AllClients], [{
            "core_requests": (0, 0), "core_replies": (0, 0),
            "ext_requests": (0, 0, 0, 0), "ext_replies": (0, 0, 0, 0),
            "delivered_events": (0, 0), "device_events": (X.KeyPress, X.ButtonPress),
            "errors": (0, 0), "client_started": False, "client_died": False}])
        rec.record_enable_context(ctx, handler)   # blocks


# ---------------------------------------------------------------- plumbing
def main():
    osd = Osd()
    layouts = Layouts(osd)
    threading.Thread(target=audiomenu.apply_echo, daemon=True).start()   # the saved echo-cancel state
    threading.Thread(target=powermenu.apply, daemon=True).start()        # the saved power mode
    jobs = queue.Queue()

    def worker():                      # one command at a time, in order
        while True:
            line = jobs.get()
            parts = line.split()
            if not parts:
                continue
            kind, arg = parts[0], (parts[1] if len(parts) > 1 else "")
            try:
                if kind == "vol":
                    do_volume(osd, arg)
                elif kind == "bright":
                    do_brightness(osd, arg)
                elif kind == "menu" and arg == "audio":   # the sound menu: one, toggled
                    GLib.idle_add(lambda: (audiomenu.toggle(), False)[1])
                elif kind == "menu" and arg == "power":   # the power menu under the battery
                    GLib.idle_add(lambda: (powermenu.toggle(), False)[1])
                elif kind == "menu":                # the network menus, hosted here so
                    GLib.idle_add(lambda a=arg: (netmenu.menu(wifi_only=a != "info", hosted=True), False)[1])
                elif kind == "layout" and arg == "next":
                    layouts.alt_shift()
                elif kind == "layout":
                    layouts.publish()
            except Exception as e:     # never let one bad command kill the daemon
                print("osd:", e, flush=True)

    def fifo_reader():
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO, 0o600)
        while True:
            with open(FIFO) as f:
                for line in f:
                    jobs.put(line.strip())

    for target in (worker, fifo_reader, layouts.watch_external, layouts.watch_keys, watch_audio):
        threading.Thread(target=target, daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    main()
