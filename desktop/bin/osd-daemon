#!/usr/bin/env python3
"""On-screen display + keyboard layout switcher for the i3 session.

OSD: an override-redirect window (so it shows above fullscreen video) in the top
right corner, fixed size so it never jumps while the value changes, 90% opaque.

Commands arrive on a FIFO (see the `osd` client):
    vol up | vol down | vol mute     change the default sink and show it
                                     (any volume change also unmutes)
    bright up | bright down          screen brightness
    layout next                      EN <-> RU (same as Alt+Shift)
    layout show                      flash the current layout

Layouts (Windows-style, switched on key RELEASE so Ctrl+Shift+V etc. keep working):
    Alt+Shift    from UA -> EN, otherwise EN <-> RU
    Ctrl+Shift   UA; pressed again on UA -> back to the previous layout
The current layout name is written to $XDG_RUNTIME_DIR/kbd-layout for the panel.
"""
import ctypes
import os
import queue
import re
import subprocess
import threading
import time

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
FIFO = os.path.join(RUN, "osd.fifo")
LAYOUT_FILE = os.path.join(RUN, "kbd-layout")
HIDE_MS = 1100
MARGIN_TOP = 56          # one-row 44px panel + gap
MARGIN_RIGHT = 24
import sys
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
from sky_theme import THEME, css
ACCENT = THEME["light"]
OVER = THEME["warning"]     # above 100%
LAYOUT_COLOURS = THEME["layouts"]   # one colour per language, the same as in the panel
VOL_STEP = 5
VOL_LIMIT = 150            # percent; the bar shows "over" above 100
PANEL_LAYOUT_PLUGIN = "genmon-55"

GLYPH = {
    "vol-high": "", "vol-low": "", "vol-mute": "\U000f075f",
    "bright": "",
}

CSS = css("""
window { background: transparent; }
#osd {
    background-color: @COLOUR_BACKGROUND@;
    border: 1px solid rgba(@RGB_LIGHT@, 0.35);
    border-radius: 12px;
    padding: 10px 16px;
}
#osd label { color: @COLOUR_FOREGROUND@; font-family: @FONT@; font-size: 15px; font-weight: 600;
             font-feature-settings: "tnum"; }
#osd label.glyph { font-family: "@MONO_FONT@"; font-size: 19px; color: @COLOUR_LIGHT@; }
#osd label.badge { font-size: 24px; font-weight: 700; color: @COLOUR_LIGHT@; letter-spacing: 2px; }
#osd label.value { color: @COLOUR_LIGHT@; }
#osd.over label.value, #osd.over label.glyph { color: @COLOUR_WARNING@; }
#osd.muted label.value, #osd.muted label.glyph { color: @COLOUR_MUTED@; }
#osd.layout-en { border-color: @COLOUR_LAYOUTS_EN@; }
#osd.layout-ru { border-color: @COLOUR_LAYOUTS_RU@; }
#osd.layout-ua { border-color: @COLOUR_LAYOUTS_UA@; }
progressbar trough { min-height: 6px; min-width: 190px; background-color: rgba(255,255,255,0.14);
                     border: none; border-radius: 3px; }
progressbar progress { min-height: 6px; background-color: @COLOUR_LIGHT@; border: none; border-radius: 3px; }
#osd.over progressbar progress { background-color: @COLOUR_WARNING@; }
#osd.muted progressbar progress { background-color: @COLOUR_DIM@; }
""").encode()


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return ""


# ---------------------------------------------------------------- OSD window
class Osd(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)   # override-redirect: above fullscreen
        self.set_app_paintable(True)
        self.set_accept_focus(False)
        self.set_resizable(False)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_opacity(0.90)  # deprecated in GTK3 docs, still the only way for a whole-window alpha

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.box.set_name("osd")
        self.icon = Gtk.Label(width_chars=2)
        self.bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
        self.value = Gtk.Label(width_chars=5, xalign=1.0)   # "100%", "150%", "muted" never resize
        self.value.get_style_context().add_class("value")
        self.box.pack_start(self.icon, False, False, 0)
        self.box.pack_start(self.bar, True, True, 0)
        self.box.pack_start(self.value, False, False, 0)
        self.add(self.box)
        self.box.show_all()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.timer = None
        self.mode = None
        self.monitor_geo = None

    def _place(self, mode):
        display = Gdk.Display.get_default()
        _, px, py = display.get_default_seat().get_pointer().get_position()
        monitor = display.get_monitor_at_point(px, py) or display.get_monitor(0)
        geo = monitor.get_geometry()
        key = (mode, geo.x, geo.y, geo.width, geo.height)
        if key == self.monitor_geo:
            return                          # same mode, same screen: never move
        self.monitor_geo = key
        self.resize(1, 1)
        width = self.get_preferred_size().natural_size.width
        self.move(geo.x + geo.width - width - MARGIN_RIGHT, geo.y + MARGIN_TOP)

    def _set_state(self, *classes):
        ctx = self.box.get_style_context()
        for c in ("over", "muted", "layout-en", "layout-ru", "layout-ua"):
            (ctx.add_class if c in classes else ctx.remove_class)(c)

    def level(self, glyph, percent, muted=False):
        ctx = self.icon.get_style_context()
        ctx.remove_class("badge")
        ctx.add_class("glyph")
        self.icon.set_text(glyph)
        self.bar.show()
        self.value.show()
        self.bar.set_fraction(max(0.0, min(1.0, percent / 100.0)))
        self.value.set_text("muted" if muted else f"{percent}%")
        self._set_state(*(["muted"] if muted else (["over"] if percent > 100 else [])))
        self._show("level")

    def badge(self, text):
        ctx = self.icon.get_style_context()
        ctx.remove_class("glyph")
        ctx.add_class("badge")
        colour = LAYOUT_COLOURS.get(text, ACCENT)
        self.icon.set_markup(f'<span foreground="{colour}">{text}</span>')
        self.bar.hide()
        self.value.hide()
        self._set_state("layout-" + text.lower() if text in LAYOUT_COLOURS else "")
        self._show("badge")

    def _show(self, mode):
        self._place(mode)
        self.show()
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(HIDE_MS, self._dismiss)

    def _dismiss(self):
        self.hide()
        self.timer = None
        return False


# ---------------------------------------------------------------- audio / brightness
_vol = {"v": None, "muted": False, "t": 0.0}


def volume_state():
    """(percent, muted) from pactl - about 20 ms a call, half of what wpctl costs."""
    out = run("pactl", "get-sink-volume", "@DEFAULT_SINK@")   # Volume: front-left: 29491 /  45% / ...
    m = re.search(r"(\d+)%", out)
    v = int(m.group(1)) if m else 0
    muted = "yes" in run("pactl", "get-sink-mute", "@DEFAULT_SINK@")
    _vol.update(v=v, muted=muted, t=time.monotonic())
    return v, muted


def show_volume(osd, v, muted):
    glyph = GLYPH["vol-mute"] if muted or v == 0 else GLYPH["vol-high" if v >= 50 else "vol-low"]
    GLib.idle_add(osd.level, glyph, v, muted)


def do_volume(osd, arg):
    sink = "@DEFAULT_SINK@"
    if arg == "mute":
        run("pactl", "set-sink-mute", sink, "toggle")
    else:
        if _vol["v"] is None or time.monotonic() - _vol["t"] > 5:
            volume_state()
        v = max(0, min(VOL_LIMIT, _vol["v"] + (VOL_STEP if arg == "up" else -VOL_STEP)))
        # the OSD moves first, then the sink: the key feels instant, and a held
        # key runs at the cost of two pactl calls per step
        show_volume(osd, v, False)
        _vol.update(v=v, muted=False, t=time.monotonic())
        run("pactl", "set-sink-mute", sink, "0")          # any change unmutes
        run("pactl", "set-sink-volume", sink, f"{v}%")
        return
    show_volume(osd, *volume_state())


def do_brightness(osd, arg):
    if arg in ("up", "down"):
        run("brightnessctl", "-q", "set", "5%+" if arg == "up" else "5%-")
    out = run("brightnessctl", "-m")                  # name,class,raw,NN%,max
    try:
        v = int(out.split(",")[3].rstrip("%\n"))
    except (IndexError, ValueError):
        v = 0
    GLib.idle_add(osd.level, GLYPH["bright"], v)


# ---------------------------------------------------------------- keyboard layouts
class Xkb:
    """Tiny ctypes wrapper: read and lock the XKB group (= layout index)."""
    class State(ctypes.Structure):
        _fields_ = [("group", ctypes.c_ubyte), ("locked_group", ctypes.c_ubyte),
                    ("base_group", ctypes.c_ushort), ("latched_group", ctypes.c_short),
                    ("mods", ctypes.c_ubyte), ("base_mods", ctypes.c_ubyte),
                    ("latched_mods", ctypes.c_ubyte), ("locked_mods", ctypes.c_ubyte),
                    ("compat_state", ctypes.c_ubyte), ("grab_mods", ctypes.c_ubyte),
                    ("compat_grab_mods", ctypes.c_ubyte), ("lookup_mods", ctypes.c_ubyte),
                    ("compat_lookup_mods", ctypes.c_ubyte), ("ptr_buttons", ctypes.c_ushort)]
    USE_CORE_KBD = 0x0100

    def __init__(self):
        self.x = ctypes.cdll.LoadLibrary("libX11.so.6")
        self.x.XOpenDisplay.restype = ctypes.c_void_p
        self.x.XkbGetState.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(self.State)]
        self.x.XkbLockGroup.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
        self.x.XFlush.argtypes = [ctypes.c_void_p]
        self.dpy = self.x.XOpenDisplay(None)
        self.lock = threading.Lock()

    def group(self):
        st = self.State()
        with self.lock:
            self.x.XkbGetState(self.dpy, self.USE_CORE_KBD, ctypes.byref(st))
        return st.group

    def set_group(self, g):
        with self.lock:
            self.x.XkbLockGroup(self.dpy, self.USE_CORE_KBD, g)
            self.x.XFlush(self.dpy)


def layout_names():
    """['EN', 'RU', 'UA'] in XKB group order, from the live keymap."""
    names = []
    for line in run("setxkbmap", "-query").splitlines():
        if line.startswith("layout:"):
            names = [n.strip() for n in line.split(":", 1)[1].split(",")]
    return [{"us": "EN", "gb": "EN"}.get(n, n.upper()) for n in names] or ["EN"]


class Layouts:
    def __init__(self, osd):
        self.osd = osd
        self.xkb = Xkb()
        self.names = layout_names()
        self.current = self.xkb.group()
        self.previous = 0
        self.changed_at = 0.0          # our own switch; the external watcher waits it out
        self.publish(show=False)

    def idx(self, name):
        return self.names.index(name) if name in self.names else None

    def publish(self, show=True):
        name = self.names[self.current] if self.current < len(self.names) else "?"
        try:
            with open(LAYOUT_FILE + ".tmp", "w") as f:
                f.write(name)
            os.replace(LAYOUT_FILE + ".tmp", LAYOUT_FILE)
        except OSError:
            pass
        threading.Thread(target=run, daemon=True, args=(
            "xfce4-panel", f"--plugin-event={PANEL_LAYOUT_PLUGIN}:refresh:bool:true")).start()
        if show:
            GLib.idle_add(self.osd.badge, name)

    def switch(self, g):
        if g is None or g == self.current:
            return
        if self.names[self.current] != "UA":
            self.previous = self.current
        self.changed_at = time.monotonic()
        self.xkb.set_group(g)
        self.current = g
        self.publish()

    def alt_shift(self):
        en, ru = self.idx("EN"), self.idx("RU")
        cur = self.names[self.current]
        if cur == "EN" and ru is not None:
            self.switch(ru)
        else:
            self.switch(en if en is not None else 0)

    def ctrl_shift(self):
        ua = self.idx("UA")
        if ua is None:
            return
        self.switch(self.previous if self.current == ua else ua)

    def watch_external(self):
        """Something else changed the layout (panel click, xkb option): follow it."""
        seen = None
        while True:
            time.sleep(0.3)
            g = self.xkb.group()
            if g == self.current or time.monotonic() - self.changed_at < 0.8:
                seen = None
                continue
            if seen != g:              # must hold for two polls in a row
                seen = g
                continue
            seen = None
            if True:
                if self.current < len(self.names) and self.names[self.current] != "UA":
                    self.previous = self.current
                self.current = g
                self.publish()

    def watch_keys(self):
        """Windows-style: the combo fires when a modifier is released and nothing
        else was pressed in between. XRecord only observes, it never grabs keys."""
        from Xlib import X, XK, display
        from Xlib.ext import record
        from Xlib.protocol import rq

        rec = display.Display()
        local = display.Display()
        cats = {}
        for sym, cat in (("Shift_L", "shift"), ("Shift_R", "shift"), ("Control_L", "ctrl"),
                         ("Control_R", "ctrl"), ("Alt_L", "alt"), ("Alt_R", "alt"),
                         ("Meta_L", "alt"), ("Meta_R", "alt"), ("Super_L", "super"),
                         ("Super_R", "super"), ("ISO_Level3_Shift", "altgr")):
            for kc, _ in local.keysym_to_keycodes(XK.string_to_keysym(sym)):
                cats[kc] = cat

        state = {"down": {}, "dirty": False}

        def handler(reply):
            data = reply.data
            while len(data):
                ev, data = rq.EventField(None).parse_binary_value(data, rec.display, None, None)
                if ev.type in (X.ButtonPress,):
                    state["dirty"] = True
                    continue
                kc = ev.detail
                cat = cats.get(kc)
                if ev.type == X.KeyPress:
                    if cat:
                        state["down"][kc] = cat
                    else:
                        state["dirty"] = True
                elif ev.type == X.KeyRelease:
                    if cat and kc in state["down"]:
                        held = set(state["down"].values())
                        if not state["dirty"]:
                            if held == {"alt", "shift"}:
                                self.alt_shift()
                                state["dirty"] = True
                            elif held == {"ctrl", "shift"}:
                                self.ctrl_shift()
                                state["dirty"] = True
                        del state["down"][kc]
                    if not state["down"]:
                        state["dirty"] = False

        ctx = rec.record_create_context(0, [record.AllClients], [{
            "core_requests": (0, 0), "core_replies": (0, 0),
            "ext_requests": (0, 0, 0, 0), "ext_replies": (0, 0, 0, 0),
            "delivered_events": (0, 0), "device_events": (X.KeyPress, X.ButtonPress),
            "errors": (0, 0), "client_started": False, "client_died": False}])
        rec.record_enable_context(ctx, handler)   # blocks


# ---------------------------------------------------------------- plumbing
def main():
    osd = Osd()
    layouts = Layouts(osd)
    jobs = queue.Queue()

    def worker():                      # one command at a time, in order
        while True:
            line = jobs.get()
            parts = line.split()
            if not parts:
                continue
            kind, arg = parts[0], (parts[1] if len(parts) > 1 else "")
            try:
                if kind == "vol":
                    do_volume(osd, arg)
                elif kind == "bright":
                    do_brightness(osd, arg)
                elif kind == "layout" and arg == "next":
                    layouts.alt_shift()
                elif kind == "layout":
                    layouts.publish()
            except Exception as e:     # never let one bad command kill the daemon
                print("osd:", e, flush=True)

    def fifo_reader():
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO, 0o600)
        while True:
            with open(FIFO) as f:
                for line in f:
                    jobs.put(line.strip())

    for target in (worker, fifo_reader, layouts.watch_external, layouts.watch_keys):
        threading.Thread(target=target, daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    main()
