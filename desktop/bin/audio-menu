#!/usr/bin/env python3
"""audio-menu: toggle the sound menu (see audiomenu.py in the shared library). It is
hosted by osd-daemon; this only asks it, and runs the menu itself when the daemon is
not there."""
import os
import sys

FIFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "osd.fifo")
sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))


def main():
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, b"menu audio\n")
        os.close(fd)
        return
    except OSError:
        pass
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    import audiomenu
    win = audiomenu.toggle()
    audiomenu._state["win"].connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
