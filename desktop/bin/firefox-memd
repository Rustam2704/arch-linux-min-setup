#!/usr/bin/env python3
"""firefox-memd — keep Firefox at a comfortable size by swapping out its coldest
memory in the background, so a new tab never has to wait for that to happen.

Why: Firefox runs under a soft ceiling (MemoryHigh, set by `firefox-limited`).
When it hits the ceiling, the kernel makes Firefox free memory synchronously,
right while a page is loading - that is the multi-second stall. This daemon does
the same work early and in small steps: above TARGET it writes to the cgroup's
memory.reclaim, and the kernel (MGLRU) picks the least recently used pages - in
practice old tabs - and moves them to zswap/SSD. Nothing is discarded or reloaded.

Safety:
  * never touches the ceiling itself (the user sets it with `firefox-mem`);
  * backs off when swapped pages come straight back (refaults), i.e. when the
    memory above TARGET is actually in use;
  * guardrail: if Firefox keeps hitting the ceiling anyway, one desktop
    notification (at most every 10 minutes) says so. Nothing is raised automatically.

Settings: ~/.config/firefox-memory.conf (re-read every cycle, no restart, no Save)
    ENABLED=1  LIMIT=4G  TARGET=2G  STEP=128M  INTERVAL=5
"""
import os
import subprocess
import time

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                    "firefox-memory.conf")
UID = os.getuid()
SCOPE = f"/sys/fs/cgroup/user.slice/user-{UID}.slice/user@{UID}.service/app.slice/firefox.scope"
DEFAULTS = {"ENABLED": "1", "LIMIT": "4G", "TARGET": "2G", "STEP": "128M", "INTERVAL": "5",
            "RECLAIM": "1"}
NOTIFY_EVERY = 600


def size(text):
    text = text.strip().upper()
    mult = {"K": 1 << 10, "M": 1 << 20, "G": 1 << 30}.get(text[-1:], 1)
    return int(float(text.rstrip("KMG")) * mult)


def settings():
    conf = dict(DEFAULTS)
    try:
        for line in open(CONF):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return conf


def read(name):
    with open(os.path.join(SCOPE, name)) as f:
        return f.read()


def stat(key):
    for line in read("memory.stat").splitlines():
        k, v = line.split()
        if k == key:
            return int(v)
    return 0


def events_high():
    for line in read("memory.events").splitlines():
        k, v = line.split()
        if k == "high":
            return int(v)
    return 0


def main():
    backoff = 1
    last_refault = None
    last_high = None
    high_streak = 0
    last_notice = 0.0
    while True:
        conf = settings()
        interval = max(1, int(float(conf["INTERVAL"])))
        time.sleep(interval * backoff)
        if conf["ENABLED"] != "1" or not os.path.isdir(SCOPE):
            last_refault = last_high = None
            continue
        try:
            current = int(read("memory.current"))
            refault = stat("workingset_refault_anon") + stat("workingset_refault_file")
            high = events_high()
        except (OSError, ValueError):
            continue

        # refaults are counted in pages; more than ~STEP coming back per cycle
        # means the memory above TARGET is hot - reclaiming it would only thrash
        step = size(conf["STEP"])
        hot = last_refault is not None and (refault - last_refault) * 4096 > step
        last_refault = refault

        if conf["RECLAIM"] == "1" and current > size(conf["TARGET"]) and not hot:
            amount = min(step, current - size(conf["TARGET"]))
            try:
                with open(os.path.join(SCOPE, "memory.reclaim"), "w") as f:
                    f.write(str(amount))
            except OSError:
                pass                     # EAGAIN: nothing cold enough right now
            backoff = 1
        elif hot:
            backoff = min(backoff * 2, 12)   # up to a minute between tries
        else:
            backoff = 1

        # guardrail: throttled at the ceiling in 6 cycles in a row (~30 s+)
        if last_high is not None and high > last_high:
            high_streak += 1
        else:
            high_streak = 0
        last_high = high
        if high_streak >= 6 and time.time() - last_notice > NOTIFY_EVERY:
            last_notice = time.time()
            subprocess.run(["notify-send", "-a", "Firefox memory", "-i", "firefox-developer-edition",
                            "Firefox is at its memory limit",
                            f"It keeps hitting the {conf['LIMIT']} ceiling, so pages load slowly. "
                            "Close some tabs, or raise the limit: firefox-mem set 5G"])


if __name__ == "__main__":
    main()
