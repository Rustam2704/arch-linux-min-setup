<?xml version="1.1" encoding="UTF-8"?>

<!-- Every key lives in ~/.config/i3/config. xfsettingsd must grab nothing of its own:
     "override" makes it use the custom list only, and that list is empty (the entries Xfce
     ships - Alt+F1/F2/F3, Ctrl+Shift+Esc, Super+P ... - were removed by lab, 55-audit-phase1). -->
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <property name="override" type="bool" value="true"/>
    </property>
  </property>
</channel>
