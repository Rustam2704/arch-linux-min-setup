# i3 config — whitebook · Xfce session · colours from desktop/share/sky-desktop/theme.json
set $mod Mod4
set $accent   @COLOUR_ACCENT@
set $bg       @COLOUR_BACKGROUND@
set $inactive @COLOUR_SURFACE@
set $text     @COLOUR_TEXT@
set $dim      @COLOUR_MUTED@

font pango:Inter 11

# --- look ---------------------------------------------------------------
# title bars on every window; deskd draws minimize / maximize / close on the right
default_border normal 2
default_floating_border normal 2
hide_edge_borders smart
gaps inner 10
gaps outer 0
smart_gaps on
title_align center

#                       border    background  text     indicator  child_border
# title backgrounds must match TITLE_BG_* in ~/.local/share/deskd/deskd.py
client.focused          $accent   $inactive   @COLOUR_LIGHT@  $accent    $accent
client.focused_inactive $inactive $bg         $dim     $inactive  $inactive
client.unfocused        $inactive $bg         $dim     $inactive  $inactive
# an urgent window looks like any other: the workspace strip in the panel carries the notice
client.urgent           $inactive $bg         $dim     $inactive  $inactive
client.background       $bg

# --- mouse ------------------------------------------------------------
# Super + left-drag moves a floating window, Super + right-drag resizes it;
# Super + left-drag on a tiled window moves it to another spot in the layout
floating_modifier $mod
# Super + right-drag anywhere inside a window: the nearest edge follows the mouse
bindsym --whole-window $mod+button3 exec --no-startup-id ~/.local/bin/i3-mouse-resize
tiling_drag modifier
# title bars (deskd, one engine for both buttons):
#   left drag: rearrange tiles / move a floating window;  right drag: pull the window out
#   drop at the top edge = maximize, left/right edge = half, on a panel number = that workspace
#   left double click = maximize <-> restore;  right click = tiled <-> floating
bindsym button1 mark --add _deskd_click, nop deskd titlebar 1
bindsym button3 mark --add _deskd_click, nop deskd titlebar 3

# --- launching ----------------------------------------------------------
bindsym $mod+Return exec kitty
bindsym $mod+d exec --no-startup-id ~/.local/bin/rofi-toggle drun
bindsym $mod+r exec --no-startup-id ~/.local/bin/rofi-toggle run
bindsym $mod+Tab exec --no-startup-id ~/.local/bin/rofi-toggle window
bindsym $mod+e exec thunar
bindsym $mod+c exec --no-startup-id ~/.local/bin/light-year
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# --- focus / move -------------------------------------------------------
# focus on j k l ; — where the right hand already rests
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
# Super+arrows as in Windows: maximize / restore-or-minimize / left half / right half
bindsym $mod+Up    nop deskd key up
bindsym $mod+Down  nop deskd key down
bindsym $mod+Left  nop deskd key left
bindsym $mod+Right nop deskd key right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- layout -------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
# maximize keeps the panel visible; an app's own fullscreen (F11, video) stays real
bindsym $mod+f nop deskd maximize
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+g layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- workspaces ---------------------------------------------------------
# Each screen has its own workspaces 1..9 (deskd): Super+N goes to N on the focused
# screen. Unplugged screens' workspaces join the laptop screen and move back later.
bindsym $mod+1 nop deskd ws 1
bindsym $mod+2 nop deskd ws 2
bindsym $mod+3 nop deskd ws 3
bindsym $mod+4 nop deskd ws 4
bindsym $mod+5 nop deskd ws 5
bindsym $mod+6 nop deskd ws 6
bindsym $mod+7 nop deskd ws 7
bindsym $mod+8 nop deskd ws 8
bindsym $mod+9 nop deskd ws 9
bindsym $mod+0 nop deskd ws 10
bindsym $mod+Shift+1 nop deskd move 1
bindsym $mod+Shift+2 nop deskd move 2
bindsym $mod+Shift+3 nop deskd move 3
bindsym $mod+Shift+4 nop deskd move 4
bindsym $mod+Shift+5 nop deskd move 5
bindsym $mod+Shift+6 nop deskd move 6
bindsym $mod+Shift+7 nop deskd move 7
bindsym $mod+Shift+8 nop deskd move 8
bindsym $mod+Shift+9 nop deskd move 9
bindsym $mod+Shift+0 nop deskd move 10

# --- resize -------------------------------------------------------------
# Direct, no mode to get stuck in: Super+Ctrl + arrows (or j k l ;)
bindsym $mod+Ctrl+Left  resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+Right resize grow width 40 px or 4 ppt
bindsym $mod+Ctrl+Up    resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+Down  resize grow height 40 px or 4 ppt
bindsym $mod+Ctrl+j         resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+semicolon resize grow width 40 px or 4 ppt
bindsym $mod+Ctrl+l         resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+k         resize grow height 40 px or 4 ppt


# --- media / brightness keys -------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/osd vol up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/osd vol down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/osd vol mute
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/osd bright up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/osd bright down
bindsym XF86KbdBrightnessUp exec --no-startup-id brightnessctl -d 'smc::kbd_backlight' set 10%+
bindsym XF86KbdBrightnessDown exec --no-startup-id brightnessctl -d 'smc::kbd_backlight' set 10%-
# screenshots as in Windows: to the clipboard and ~/Pictures/Screenshots
bindsym Print exec --no-startup-id ~/.local/bin/snip screen
bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/snip area

# --- Windows habits -------------------------------------------------------
# Alt+Tab: next window on this workspace (one hand, no arrows); Alt+Shift+Tab: previous
bindsym Mod1+Tab nop deskd cycle
bindsym Mod1+Shift+Tab nop deskd cycle prev
# Ctrl+Shift+Esc: system monitor
bindsym Ctrl+Shift+Escape exec --no-startup-id kitty --class btop-float -e btop

# --- "minimize": i3 has none, the scratchpad is its equivalent ------------
bindsym $mod+minus nop deskd minimize
bindsym $mod+Shift+minus nop deskd unminimize

# --- remote desktop --------------------------------------------------------
# While a RustDesk window is focused, every key (Super+...) goes to the remote
# machine; deskd switches this mode on and off with the focus. Super+Esc leaves it.
mode "passthrough" {
    bindsym $mod+Escape mode "default"
    # the title bar must still work with the mouse (mouse bindings are per mode too)
    bindsym button1 mark --add _deskd_click, nop deskd titlebar 1
    bindsym button3 mark --add _deskd_click, nop deskd titlebar 3
    # the remote machine gets every other key; moving the window itself must still work
    bindsym $mod+Shift+1 nop deskd move 1
    bindsym $mod+Shift+2 nop deskd move 2
    bindsym $mod+Shift+3 nop deskd move 3
    bindsym $mod+Shift+4 nop deskd move 4
    bindsym $mod+Shift+5 nop deskd move 5
    bindsym $mod+Shift+6 nop deskd move 6
    bindsym $mod+Shift+7 nop deskd move 7
    bindsym $mod+Shift+8 nop deskd move 8
    bindsym $mod+Shift+9 nop deskd move 9
    bindsym $mod+Shift+0 nop deskd move 10
}

# --- session ------------------------------------------------------------
bindsym $mod+slash exec --no-startup-id ~/.local/bin/i3-cheatsheet
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/power-menu

# Clicking a window in the taskbar (or any app asking for focus) switches to it,
# instead of i3's default of only marking it urgent when it sits on another workspace.
focus_on_window_activation focus
# focus by click, like Windows (the user found focus-follows-mouse annoying)
focus_follows_mouse no

# --- window rules -------------------------------------------------------
# Apps like kitty ask for "no decorations" and i3 obeys, leaving them with no border
# at all. Force a title bar + thin border on everything first.
for_window [class=".*"] border normal 2
for_window [class="Xfce4-panel"] floating enable, border none
for_window [window_role="pop-up"] floating enable
for_window [class="Pavucontrol|Xfce4-appfinder|Nm-connection-editor"] floating enable
# Zoom: main and meeting windows tile like everything else; only its popups float
# (dialogs and utility windows already float by default)
for_window [class="(?i)zoom" window_type="notification"] floating enable
# (not "zoom": every Zoom window starts with that title before renaming itself)
for_window [class="(?i)zoom" title="^(Settings|Participants|Chat)$"] floating enable
# During a screen share Zoom pops its annotation toolbar and the small self-view as
# "normal" windows; tiled, they split the workspace. They are overlays: float them
# without a frame and never take the focus for them.
for_window [class="(?i)zoom" title="^(annotate_toolbar|zoom_linux_float_video_window)$"] floating enable, border none
no_focus [class="(?i)zoom" title="^(annotate_toolbar|zoom_linux_float_video_window)$"]
for_window [title="Flameshot"] floating enable, border none
for_window [class="btop-float"] floating enable, resize set 70 ppt 75 ppt, move position center
for_window [class="deskd-menu"] floating enable, border none

# --- autostart ----------------------------------------------------------
# GUI helpers need the X display and i3, so i3 starts them (not systemd at login):
# on-screen display + keyboard layouts, and deskd (title buttons, snapping, workspaces)
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY && systemctl --user start osd.service deskd.service
# favorites, if "Launch favorites at login" is on in the Apple-button menu
exec --no-startup-id ~/.local/bin/deskd-favorites --login

# --- generated ------------------------------------------------------------
# App -> workspace rules and other generated pieces (see ~/.config/deskd/)
include ~/.config/i3/generated/*.conf

# Native Astra starfield, started only after the graphical session environment is ready.
exec_always --no-startup-id sh -c 'systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS; systemctl --user start sky-stars.service'
