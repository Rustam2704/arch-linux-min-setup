[Unit]
# Started after i3 imports the graphical session environment.
StartLimitIntervalSec=60
StartLimitBurst=5
Description=deskd: Windows-style window handling for i3 (title buttons, edge resize, snap, per-screen workspaces) (setup/lab)
After=graphical-session.target

[Service]
Environment=SKY_LAB=@PROJECT@/lab/lab
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/deskd/deskd.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
