#!/usr/bin/env python3
"""CPU and memory for the panel (genmon).

Deliberately plain numbers: load since the previous update, memory that is
actually unavailable (MemAvailable, not "used"), and swap only when something
is in it.
"""
import os

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "panel-sys.state")
ACCENT = "#48daf9"
DIM = "#5b6b76"
WARN = "#e0a33e"
CRIT = "#e05561"
GAP = '<span size="50%"> </span>'      # half a space: a word and its number belong together


def cpu_percent():
    with open("/proc/stat") as f:
        parts = [int(x) for x in f.readline().split()[1:]]
    idle, total = parts[3] + parts[4], sum(parts)
    prev_idle = prev_total = 0
    try:
        with open(STATE) as f:
            prev_idle, prev_total = (int(x) for x in f.read().split())
    except (OSError, ValueError):
        pass
    with open(STATE, "w") as f:
        f.write(f"{idle} {total}")
    d_total = total - prev_total
    d_idle = idle - prev_idle
    if d_total <= 0:
        return 0
    return max(0, min(100, round(100 * (d_total - d_idle) / d_total)))


def meminfo():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
    total = info["MemTotal"]
    used = total - info.get("MemAvailable", info["MemFree"])
    swap_total = info.get("SwapTotal", 0)
    swap_used = swap_total - info.get("SwapFree", 0)
    return round(100 * used / total), used // 1024, total // 1024, swap_used // 1024


def colour(pct):
    return CRIT if pct >= 90 else WARN if pct >= 75 else ACCENT


cpu = cpu_percent()
mem_pct, mem_used, mem_total, swap_used = meminfo()

def value(text, colour, width):
    """Keep a full tabular-digit cell for every missing character."""
    room = "\u2007" * max(0, width - len(text))
    return f'<span foreground="{colour}">{text}{room}</span>'


def panel_percent(pct):
    """Two digit positions; 100 and above roll over to 00 as requested."""
    return "00" if pct >= 100 else str(pct)


parts = [f'<span foreground="{DIM}">CPU</span>{GAP}{value(panel_percent(cpu) + "%", colour(cpu), 3)}',
         f'<span foreground="{DIM}">RAM</span>{GAP}{value(panel_percent(mem_pct) + "%", colour(mem_pct), 3)}']
if swap_used > 64:
    swap_txt = f"{swap_used / 1024:.1f}G" if swap_used >= 1024 else f"{swap_used}M"
    parts.append(f'<span foreground="{DIM}">SWAP</span>{GAP}{value(swap_txt, "#c6d0d9", 5)}')

print('<txt><span font_features="tnum"> ' + "  ".join(parts) + "</span></txt>")
print(f"<tool>CPU: {cpu}%\nMemory: {mem_used} of {mem_total} MB ({mem_pct}%)\n"
      f"Swap: {swap_used} MB (on SSD)</tool>")
