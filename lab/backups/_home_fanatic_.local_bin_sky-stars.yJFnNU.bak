#!/usr/bin/env python3
"""sky-stars - a black desktop with slowly twinkling stars, as cheap as a wallpaper.

How it stays cheap
  * The whole animation is a precomputed 30-second loop ("a video"): every star's
    brightness step for every frame is tabulated once at start-up; the frame loop
    does no trigonometry and no random numbers.
  * A frame only draws the stars whose step changed, grouped by step into one
    PolyFillRectangle request per step (at most two dozen requests a frame).
  * Stars under a window are not drawn at all. The covered area comes from the i3
    tree (visible workspaces, docks, floating and full-screen windows); when
    everything is covered the loop sleeps until i3 reports a change.
  * No GTK: python-xlib only, a select() loop over the X socket and the i3 socket.

Why a window and not the root pixmap
  Under picom the root window itself is never shown - the compositor paints its
  own copy of the root pixmap and only re-reads it when the _XROOTPMAP_ID property
  changes, which would mean a full-screen recomposite for every frame. An
  override-redirect window of type DESKTOP at the bottom of the stack gets exact
  damage tracking instead: picom recomposites only the changed star rectangles.
  i3 ignores override-redirect windows, so no frame, no title, every workspace.

The star field itself (hash, density, phase, brightness curve) is Astra's sparkle
field from OpenAI Codex (Apache-2.0, see LICENSE-codex.txt next to sky_theme.py);
the periods are snapped to divisors of the loop so the loop is seamless.
"""
import array
import struct
import math
import os
import select
import sys
import time

from Xlib import X, Xatom, display, error
from Xlib.ext import shape
from Xlib.protocol import rq

sys.path.insert(0, os.path.expanduser("~/.local/share/sky-desktop"))
import i3ipc  # noqa: E402
from sky_theme import rgb as theme_rgb  # noqa: E402

LOOP_S = 30                 # length of the precomputed loop
FRAME_MS = 250              # 4 frames a second is plenty for a slow twinkle
FRAMES = LOOP_S * 1000 // FRAME_MS
STEPS = 12                  # brightness steps above "off" (0)
CELL_W, CELL_H = 20, 28     # grid cell in pixels; density is one star per five cells
CORE, HALO = 3, 5           # star: a 3 px square with a dim 5 px halo
DOTS = ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (0, 3), (1, 3))
ALWAYS = os.environ.get("SKY_STARS_ALWAYS") == "1"   # draw under windows too (for measuring)


def log(*a):
    print("sky-stars:", *a, flush=True)


class FillRectangles(rq.Request):
    """PolyFillRectangle with the rectangle list already packed: python-xlib packs
    a list of tuples one struct at a time in Python, which costs more than the
    whole rest of a frame. Sequence numbers and errors still go through Xlib."""
    _request = rq.Struct(rq.Opcode(70), rq.Pad(1), rq.RequestLength(),
                         rq.Drawable("drawable"), rq.GC("gc"), rq.Binary("rectangles"))


# ------------------------------------------------------------------ the field
def field(columns, rows):
    """(column, row, hash) for every cell that holds a star - deterministic."""
    for y in range(rows):
        for x in range(columns):
            h = y * 65537 + x
            h = ((h ^ (h >> 16)) * 0x45d9f3b) & ((1 << 64) - 1)
            h = ((h ^ (h >> 16)) * 0x45d9f3b) & ((1 << 64) - 1)
            h ^= h >> 16
            if h % 5 == 0:
                yield x, y, h


def step_of(h, t):
    """Brightness step (0..STEPS) of star h at loop time t. Period 30/k seconds,
    k = 4..8, so 3.75-7.5 s like the original 4-7 s but seamless over the loop."""
    period = LOOP_S / (4 + h % 5)
    phase = (t / period + (h % 997) / 997.0) % 1.0
    value = math.sin(phase * math.pi) ** 12 * 0.55
    if value < 0.04:
        return 0
    return max(1, min(STEPS, round(value / 0.55 * STEPS)))


class Sky:
    def __init__(self):
        self.d = display.Display()
        self.screen = self.d.screen()
        self.root = self.screen.root
        self.i3 = i3ipc.I3()
        self.events = i3ipc.subscribe(["window", "workspace", "output"])
        self.events.setblocking(False)
        self.buf = b""
        self.atoms = {n: self.d.intern_atom(n) for n in (
            "_NET_WM_WINDOW_TYPE", "_NET_WM_WINDOW_TYPE_DESKTOP", "_NET_WM_STATE",
            "_NET_WM_STATE_BELOW", "_NET_WM_STATE_STICKY", "_NET_WM_STATE_SKIP_TASKBAR",
            "_NET_WM_STATE_SKIP_PAGER", "_NET_WM_NAME", "UTF8_STRING")}
        self.width = self.height = 0
        self.win = None
        self.gcs = []            # per step: (halo gc, core gc); step 0 erases
        self.rethink_at = None   # when to recompute the covered set (coalesces i3 events)
        self.any_visible = True
        self.build()

    # ------------------------------------------------------------ window
    def build(self):
        geo = self.root.get_geometry()
        if (geo.width, geo.height) == (self.width, self.height) and self.win is not None:
            return
        self.width, self.height = geo.width, geo.height
        if self.win is None:
            self.win = self.root.create_window(
                0, 0, self.width, self.height, 0, self.screen.root_depth, X.InputOutput,
                X.CopyFromParent, override_redirect=1, background_pixel=0,
                event_mask=X.ExposureMask | X.StructureNotifyMask)
            self.win.set_wm_class("sky-stars", "SkyStars")
            self.win.set_wm_name("Sky stars")
            self.win.change_property(self.atoms["_NET_WM_NAME"], self.atoms["UTF8_STRING"], 8, b"Sky stars")
            self.win.change_property(self.atoms["_NET_WM_WINDOW_TYPE"], Xatom.ATOM, 32,
                                     [self.atoms["_NET_WM_WINDOW_TYPE_DESKTOP"]])
            self.win.change_property(self.atoms["_NET_WM_STATE"], Xatom.ATOM, 32, [
                self.atoms[n] for n in ("_NET_WM_STATE_BELOW", "_NET_WM_STATE_STICKY",
                                        "_NET_WM_STATE_SKIP_TASKBAR", "_NET_WM_STATE_SKIP_PAGER")])
            # clicks go through to the root window, like a wallpaper
            shape.rectangles(self.win, shape.SO.Set, shape.SK.Input, 0, 0, 0, [])
            fg = theme_rgb("foreground")
            for step in range(STEPS + 1):
                v = step / STEPS * 0.55
                self.gcs.append((self.win.create_gc(foreground=self.pixel(fg, v * 0.22)),
                                 self.win.create_gc(foreground=self.pixel(fg, v))))
            self.win.map()
        else:
            self.win.configure(x=0, y=0, width=self.width, height=self.height)
        self.win.configure(stack_mode=X.Below)
        self.tabulate()
        self.win.clear_area(0, 0, self.width, self.height)
        self.visible = bytearray(len(self.sx))     # filled in by rethink()
        self.rethink()
        self.d.flush()

    @staticmethod
    def pixel(rgb, v):
        r, g, b = (round(c * v) for c in rgb)
        return (r << 16) | (g << 8) | b

    # ------------------------------------------------------------ the loop table
    def tabulate(self):
        """Positions of every star and, per frame, which stars change to which step."""
        columns, rows = math.ceil(self.width / CELL_W), math.ceil(self.height / CELL_H)
        stars = list(field(columns, rows))
        self.sx, self.sy = array.array("h"), array.array("h")
        self.halo, self.core = [], []                               # packed X rectangles per star
        for x, y, h in stars:
            col, row = DOTS[h // 161 % 8]
            px, py = int((x + (0.28 if col == 0 else 0.72)) * CELL_W), int((y + (row + 0.5) / 4) * CELL_H)
            self.sx.append(px)
            self.sy.append(py)
            self.halo.append(struct.pack("=hhHH", px - 2, py - 2, HALO, HALO))
            self.core.append(struct.pack("=hhHH", px - 1, py - 1, CORE, CORE))
        n = len(stars)
        self.steps = [bytearray(n) for _ in range(FRAMES)]          # step of every star, per frame
        for f in range(FRAMES):
            t = f * FRAME_MS / 1000
            row = self.steps[f]
            for i, (_, _, h) in enumerate(stars):
                row[i] = step_of(h, t)
        self.changes = []                                           # per frame: {step: array of star indexes}
        for f in range(FRAMES):
            now, before = self.steps[f], self.steps[f - 1]
            frame = {}
            for i in range(n):
                if now[i] != before[i]:
                    frame.setdefault(now[i], array.array("H")).append(i)
            self.changes.append(frame)
        per_frame = sum(sum(len(a) for a in c.values()) for c in self.changes) / FRAMES
        log(f"{n} stars on {columns}x{rows} cells, {FRAMES} frames, {per_frame:.0f} changes/frame")

    # ------------------------------------------------------------ drawing
    def draw(self, groups, only_visible=True):
        """groups: {step: iterable of star indexes}. Halos first, then cores, so a
        halo never lands on a neighbour's core (cells are far wider than halos)."""
        vis, halo, core = self.visible, self.halo, self.core
        idx = {step: [i for i in stars if vis[i]] if only_visible else list(stars)
               for step, stars in groups.items()}
        for step, stars in idx.items():                   # step 0: black halo = erase
            if stars:
                self.fill(self.gcs[step][0], b"".join([halo[i] for i in stars]))
        for step, stars in idx.items():
            if step and stars:
                self.fill(self.gcs[step][1], b"".join([core[i] for i in stars]))

    def fill(self, gc, rectangles):
        FillRectangles(display=self.d.display, drawable=self.win.id, gc=gc.id, rectangles=rectangles)

    def frame_index(self, now=None):
        return int((now or time.monotonic()) * 1000 / FRAME_MS) % FRAMES

    def redraw(self, indexes, only_visible=True):
        """Bring the given stars to their current step (after uncovering or an expose)."""
        steps = self.steps[self.frame_index()]
        groups = {}
        for i in indexes:
            groups.setdefault(steps[i], array.array("H")).append(i)
        self.draw(groups, only_visible)

    # ------------------------------------------------------------ what is covered
    def covering_rects(self):
        """Screen rectangles of everything i3 shows: docks (the panel), and every
        window on a visible workspace - tiled, floating or full-screen."""
        shown = {w["name"] for w in self.i3.workspaces() if w.get("visible")}
        rects = []

        def add(node):
            r, deco = node.get("rect", {}), node.get("deco_rect", {})
            if r.get("width") and r.get("height"):
                rects.append((r["x"], r["y"] - deco.get("height", 0),
                              r["width"], r["height"] + deco.get("height", 0)))

        tree = self.i3.tree()
        for output in tree.get("nodes", []):
            for area in output.get("nodes", []):
                if area.get("type") == "dockarea":
                    for dock in area.get("nodes", []):
                        add(dock)
                elif area.get("type") == "con":                 # "content"
                    for ws in area.get("nodes", []):
                        if ws.get("name") not in shown:
                            continue
                        for node, _ in i3ipc.walk(ws):
                            if node.get("window"):
                                add(node)
        return rects

    def rethink(self):
        self.rethink_at = None
        try:
            rects = [] if ALWAYS else self.covering_rects()
        except Exception as e:                                 # i3 restarting: try again soon
            log("i3 query failed:", e)
            self.rethink_at = time.monotonic() + 1
            return
        sx, sy = self.sx, self.sy
        new = bytearray(len(sx))
        for i in range(len(sx)):
            x0, y0 = sx[i] - 2, sy[i] - 2
            for (rx, ry, rw, rh) in rects:
                if rx <= x0 and ry <= y0 and x0 + HALO <= rx + rw and y0 + HALO <= ry + rh:
                    break
            else:
                new[i] = 1
        uncovered = [i for i in range(len(sx)) if new[i] and not self.visible[i]]
        self.visible = new
        if uncovered:
            self.redraw(uncovered)
        self.win.configure(stack_mode=X.Below)                 # stay the wallpaper
        self.d.flush()
        self.any_visible = any(new)

    # ------------------------------------------------------------ events
    def on_x(self):
        exposed = []
        while self.d.pending_events():
            e = self.d.next_event()
            if e.type == X.Expose:
                exposed.append((e.x, e.y, e.width, e.height))
        if exposed:
            hit = [i for i in range(len(self.sx)) if any(
                rx - HALO <= self.sx[i] <= rx + rw + HALO and ry - HALO <= self.sy[i] <= ry + rh + HALO
                for (rx, ry, rw, rh) in exposed)]
            self.redraw(hit, only_visible=False)
            self.d.flush()

    def on_i3(self):
        try:
            while True:
                chunk = self.events.recv(65536)
                if not chunk:
                    raise ConnectionError("i3 closed the event socket")
                self.buf += chunk
        except BlockingIOError:
            pass
        events, self.buf = i3ipc.decode(self.buf)
        for name, payload in events:
            if name == "output":
                self.build()                                   # screen may have changed size
            elif name == "window" and payload.get("change") in ("title", "urgent", "mark"):
                continue
            if self.rethink_at is None:
                self.rethink_at = time.monotonic() + 0.1       # coalesce bursts

    # ------------------------------------------------------------ main loop
    def run(self):
        xfd, ifd = self.d.fileno(), self.events.fileno()
        last = self.frame_index()
        while True:
            now = time.monotonic()
            timeout = None
            if self.any_visible:
                timeout = (math.floor(now * 1000 / FRAME_MS) + 1) * FRAME_MS / 1000 - now
            if self.rethink_at is not None:
                timeout = max(0, min(timeout if timeout is not None else 1e9, self.rethink_at - now))
            readable, _, _ = select.select([xfd, ifd], [], [], timeout)
            if xfd in readable:
                self.on_x()
            if ifd in readable:
                self.on_i3()
            now = time.monotonic()
            if self.rethink_at is not None and now >= self.rethink_at:
                self.rethink()
            if self.any_visible:
                f = self.frame_index(now)
                if f != last:
                    # normally one step; after a pause or a stall just catch up to now
                    if (f - last) % FRAMES == 1:
                        self.draw(self.changes[f])
                    else:
                        self.redraw(range(len(self.sx)))
                    self.d.flush()
                    last = f


if __name__ == "__main__":
    try:
        Sky().run()
    except (ConnectionError, error.DisplayError, error.ConnectionClosedError) as e:
        log("stopped:", e)
        sys.exit(1)
