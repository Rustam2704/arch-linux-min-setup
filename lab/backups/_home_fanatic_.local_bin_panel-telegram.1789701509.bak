#!/usr/bin/env python3
"""Telegram for the panel (genmon): icon plus the number of unread messages.

Telegram refuses to draw the counter on a themed monochrome tray icon, so the
number is taken from its window title, which carries the same count that the
"badge counter" setting in Telegram produces (archived and muted chats excluded
when that is switched off).
"""
import re
import subprocess

ACCENT = "#48daf9"
GLYPH = ""          # paper plane

title = ""
try:
    out = subprocess.run(["xdotool", "search", "--class", "TelegramDesktop", "getwindowname", "%@"],
                         capture_output=True, text=True, timeout=3).stdout
    title = " ".join(out.split("\n"))
except Exception:
    pass

running = bool(title.strip())
match = re.search(r"\((\d+)\)", title)
count = int(match.group(1)) if match else 0

if not running:
    print(f'<txt> <span font_family="JetBrainsMono Nerd Font" foreground="#5b6b76">{GLYPH}</span></txt>')
    print("<tool>Telegram не запущен</tool>")
elif count:
    print(f'<txt> <span font_family="JetBrainsMono Nerd Font" foreground="{ACCENT}">{GLYPH}</span>'
          f' <span foreground="{ACCENT}" weight="bold">{count}</span></txt>')
    print(f"<tool>Telegram: непрочитанных {count}</tool>")
else:
    print(f'<txt> <span font_family="JetBrainsMono Nerd Font" foreground="#c6d0d9">{GLYPH}</span></txt>')
    print("<tool>Telegram: нет непрочитанных</tool>")
