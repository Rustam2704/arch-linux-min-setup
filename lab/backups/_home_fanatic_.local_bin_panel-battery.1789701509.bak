#!/usr/bin/env python3
"""Battery for the panel (genmon).

This pack's batteries stop charging at ~97% because the cell is worn, and the
firmware then reports "Full". Showing 97% forever is just confusing, so a full
battery is shown as full.
"""
import glob
import os

ACCENT = "#48daf9"
WARN = "#e0a33e"
CRIT = "#e05561"


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


bat = next(iter(sorted(glob.glob("/sys/class/power_supply/BAT*"))), None)
if not bat:
    print("<txt></txt>")
    raise SystemExit

status = read(os.path.join(bat, "status"), "Unknown")
try:
    pct = int(read(os.path.join(bat, "capacity"), "0"))
except ValueError:
    pct = 0

full = status == "Full" or (status != "Discharging" and pct >= 97)
if full:
    glyph, colour, label = "", ACCENT, "заряжена"
elif status == "Charging":
    glyph, colour, label = "", ACCENT, f"{pct}%"
else:
    steps = ["", "", "", "", ""]
    glyph = steps[min(4, pct // 21)]
    colour = CRIT if pct <= 10 else WARN if pct <= 20 else "#c6d0d9"
    label = f"{pct}%"

# Worn batteries: show the real health in the tooltip, not in the panel.
try:
    fd = int(read(os.path.join(bat, "charge_full_design")) or read(os.path.join(bat, "energy_full_design")))
    fn = int(read(os.path.join(bat, "charge_full")) or read(os.path.join(bat, "energy_full")))
    health = f"\nИзнос: ёмкость {100 * fn // fd}% от заводской"
except (ValueError, ZeroDivisionError, TypeError):
    health = ""

print(f'<txt> <span font_family="JetBrainsMono Nerd Font" foreground="{colour}">{glyph}</span> '
      f'<span foreground="{colour}">{label}</span></txt>')
print(f'<tool>Батарея: {pct}% ({status}){health}</tool>')
