# i3 config — whitebook · Xfce session · accent #0d8ecb
set $mod Mod4
set $accent   #0d8ecb
set $bg       #000000
set $inactive #12171a
set $text     #c6d0d9
set $dim      #5b6b76
set $urgent   #e05561

font pango:Inter 11

# --- look ---------------------------------------------------------------
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 8
gaps outer 0
smart_gaps on
smart_borders on
title_align center

#                       border    background  text     indicator  child_border
client.focused          $accent   $accent     $bg      $accent    $accent
client.focused_inactive $inactive $inactive   $dim     $inactive  $inactive
client.unfocused        $inactive $inactive   $dim     $inactive  $inactive
client.urgent           $urgent   $urgent     $bg      $urgent    $urgent
client.background       $bg

# --- mouse ------------------------------------------------------------
# Super + left-drag moves a floating window, Super + right-drag resizes it;
# Super + left-drag on a tiled window moves it to another spot in the layout
floating_modifier $mod
# Super + right-drag anywhere inside a window: the nearest edge follows the mouse
bindsym --whole-window $mod+button3 exec --no-startup-id ~/.local/bin/i3-mouse-resize
tiling_drag modifier titlebar

# --- launching ----------------------------------------------------------
bindsym $mod+Return exec kitty
bindsym $mod+d exec --no-startup-id ~/.local/bin/rofi-toggle drun
bindsym $mod+Shift+d exec --no-startup-id ~/.local/bin/rofi-toggle run
bindsym $mod+Tab exec --no-startup-id ~/.local/bin/rofi-toggle window
bindsym $mod+e exec thunar
bindsym $mod+c exec --no-startup-id ~/.local/bin/mini-calendar
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# --- focus / move -------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- layout -------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+g layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- workspaces ---------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- resize -------------------------------------------------------------
# Direct, no mode to get stuck in: Super+Ctrl + arrows (or h j k l)
bindsym $mod+Ctrl+Left  resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+Right resize grow width 40 px or 4 ppt
bindsym $mod+Ctrl+Up    resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+Down  resize grow height 40 px or 4 ppt
bindsym $mod+Ctrl+h     resize shrink width 40 px or 4 ppt
bindsym $mod+Ctrl+l     resize grow width 40 px or 4 ppt
bindsym $mod+Ctrl+k     resize shrink height 40 px or 4 ppt
bindsym $mod+Ctrl+j     resize grow height 40 px or 4 ppt


# --- media / brightness keys -------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && ~/.local/bin/osd vol
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && ~/.local/bin/osd vol
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.local/bin/osd vol
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+ && ~/.local/bin/osd brightness
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- && ~/.local/bin/osd brightness
bindsym XF86KbdBrightnessUp exec --no-startup-id brightnessctl -d 'smc::kbd_backlight' set 10%+
bindsym XF86KbdBrightnessDown exec --no-startup-id brightnessctl -d 'smc::kbd_backlight' set 10%-
bindsym Print exec --no-startup-id flameshot gui

# --- "minimize": i3 has none, the scratchpad is its equivalent ------------
bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show, floating disable

# --- session ------------------------------------------------------------
bindsym $mod+slash exec --no-startup-id ~/.local/bin/i3-cheatsheet
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/power-menu

# Clicking a window in the taskbar (or any app asking for focus) switches to it,
# instead of i3's default of only marking it urgent when it sits on another workspace.
focus_on_window_activation focus

# --- window rules -------------------------------------------------------
# Apps like kitty ask for "no decorations" and i3 obeys, leaving them with no border
# at all (no focus line). Force the thin accent border on everything first.
for_window [class=".*"] border pixel 2
for_window [class="Xfce4-panel"] floating enable, border none
for_window [window_role="pop-up"] floating enable
for_window [class="Pavucontrol|Xfce4-appfinder|Nm-connection-editor"] floating enable
# Zoom: main and meeting windows tile like everything else; only its popups float
# (dialogs and utility windows already float by default)
for_window [class="(?i)zoom" window_type="notification"] floating enable
# (not "zoom": every Zoom window starts with that title before renaming itself)
for_window [class="(?i)zoom" title="^(Settings|Participants|Chat)$"] floating enable
for_window [title="Flameshot"] floating enable, border none

# --- autostart ----------------------------------------------------------
