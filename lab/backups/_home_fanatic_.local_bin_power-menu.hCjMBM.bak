#!/bin/sh
# Immediate power actions for the i3 session (no xfce4-session here, so the
# panel's stock Actions button would only schedule a shutdown 1 minute later).
pkill -x rofi 2>/dev/null
choice=$(printf 'Shut down\nReboot\nSuspend\nLog out\n' |
    rofi -dmenu -i -p "power" -no-custom -theme-str 'window { width: 22%; } listview { lines: 4; }')

case "$choice" in
    "Shut down") systemctl poweroff ;;
    Reboot)      systemctl reboot ;;
    Suspend)     systemctl suspend ;;
    "Log out")   i3-msg exit ;;
esac
