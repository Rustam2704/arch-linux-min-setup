[Unit]
# Started by i3 (exec in ~/.config/i3/config) once the X display exists; never gives up restarting
StartLimitIntervalSec=0
Description=deskd: Windows-style window handling for i3 (title buttons, edge resize, snap, per-screen workspaces) (setup/lab)
After=graphical-session.target

[Service]
Environment=DISPLAY=:0
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/deskd/deskd.py
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
