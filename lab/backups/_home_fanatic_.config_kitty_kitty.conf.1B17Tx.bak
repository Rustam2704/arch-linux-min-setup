# kitty — whitebook
font_family      JetBrainsMono Nerd Font Mono
font_size        11.0
adjust_line_height 108%
disable_ligatures never

background            #000000
foreground            #c6d0d9
cursor                #0d8ecb
cursor_text_color     #000000
selection_background  #17384a
selection_foreground  #e4ebf0
url_color             #0d8ecb
background_opacity    0.92

color0  #12171a
color8  #3a464e
color1  #e05561
color9  #ef6b76
color2  #71c36a
color10 #89d982
color3  #e0a453
color11 #f0bb6a
color4  #0d8ecb
color12 #2ba3dd
color5  #9a7fd6
color13 #b39bea
color6  #3fbbf2
color14 #6ad2fa
color7  #9aa7b0
color15 #e4ebf0

window_padding_width 8
hide_window_decorations yes
confirm_os_window_close 0
enable_audio_bell no
scrollback_lines 20000
tab_bar_style powerline

# newline without sending, for Claude Code and friends
map shift+enter send_text all \x1b\r

# --- copying -------------------------------------------------------------
# Selecting text copies it straight to the clipboard, not only to the X primary
# selection, so Ctrl+V works in any other program afterwards. Inside a program
# that reads the mouse itself (Claude Code, codex, vim) hold Shift while
# selecting - that is kitty's own way past the program's mouse handling.
# Ctrl+C copies the selection and clears it; with nothing selected it is the
# plain interrupt the program expects, so the key keeps both jobs.
copy_on_select clipboard
map --allow-fallback=shifted,ascii ctrl+c copy_and_clear_or_interrupt
map --allow-fallback=shifted,ascii ctrl+shift+c copy_to_clipboard
map --allow-fallback=shifted,ascii ctrl+shift+v paste_from_clipboard

# --- mouse: paste only with Ctrl+V ---------------------------------------
# A full-screen app (Claude Code) receives mouse clicks itself, and a stray right
# click used to paste there. kitty now swallows right clicks instead of passing
# them on, and the middle button no longer pastes the selection either.
map --allow-fallback=shifted,ascii ctrl+v paste_from_clipboard
mouse_map right press grabbed discard_event
mouse_map right release grabbed discard_event
mouse_map right press ungrabbed no_op
mouse_map right release ungrabbed no_op
mouse_map middle release ungrabbed no_op
mouse_map middle release grabbed discard_event

# --- clicking paths ------------------------------------------------------
# A path counts as one word (so a click selects all of it), Ctrl+click opens it,
# and the middle button shows a small menu for it. Plain left click still selects
# text as usual.
select_by_word_characters @-./_~?&=%+#:
# The kitten sees the click position plus neighboring screen rows, so it can
# reconstruct paths split by a full-screen TUI's hard visual wrapping.
mouse_map ctrl+left press ungrabbed,grabbed kitten open-click.py
mouse_map middle press ungrabbed,grabbed combine : mouse_selection word : pass_selection_to_program /home/fanatic/.local/bin/open-path --menu

# A path that a click cannot catch by itself - wrapped over two lines, or with
# spaces in it - is selected by hand and opened with Ctrl+Shift+O
# (Ctrl+Shift+Alt+O for the small menu: open / show in Thunar / copy).
map --allow-fallback=shifted,ascii ctrl+shift+o pass_selection_to_program /home/fanatic/.local/bin/open-path
map --allow-fallback=shifted,ascii ctrl+shift+alt+o pass_selection_to_program /home/fanatic/.local/bin/open-path --menu
