#!/usr/bin/env python3
"""Network speed for the panel (genmon): the interface that actually carries the
default route, so it never ends up showing loopback or a sleeping interface."""
import os
import time

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "panel-net.state")
ACCENT = "#48daf9"
DIM = "#5b6b76"


def default_iface():
    try:
        with open("/proc/net/route") as f:
            next(f)
            for line in f:
                fields = line.split()
                if fields[1] == "00000000":       # destination 0.0.0.0
                    return fields[0]
    except OSError:
        pass
    return None


def counters(iface):
    with open("/proc/net/dev") as f:
        for line in f:
            name, _, rest = line.partition(":")
            if name.strip() == iface:
                values = rest.split()
                return int(values[0]), int(values[8])
    return 0, 0


def human(rate):
    if rate >= 1024 * 1024:
        return f"{rate / 1024 / 1024:.1f}M"
    if rate >= 1024:
        return f"{rate / 1024:.0f}K"
    return f"{rate:.0f}B"


iface = default_iface()
if not iface:
    print(f'<txt><span foreground="{DIM}">нет сети</span></txt><tool>Нет маршрута по умолчанию</tool>')
    raise SystemExit

rx, tx = counters(iface)
now = time.time()
prev = None
try:
    with open(STATE) as f:
        p_iface, p_time, p_rx, p_tx = f.read().split()
        if p_iface == iface:
            prev = (float(p_time), int(p_rx), int(p_tx))
except (OSError, ValueError):
    pass
with open(STATE, "w") as f:
    f.write(f"{iface} {now} {rx} {tx}")

if not prev or now - prev[0] <= 0:
    down = up = 0.0
else:
    span = now - prev[0]
    down = max(0, (rx - prev[1]) / span)
    up = max(0, (tx - prev[2]) / span)

print(f'<txt><span foreground="{DIM}">↓</span> <span foreground="{ACCENT}">{human(down)}</span>'
      f'  <span foreground="{DIM}">↑</span> <span foreground="#c6d0d9">{human(up)}</span></txt>')
print(f"<tool>Интерфейс: {iface}\nПринято всего: {rx / 1024 / 1024:.0f} МБ\nОтправлено всего: {tx / 1024 / 1024:.0f} МБ</tool>")
