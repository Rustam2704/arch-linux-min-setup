#!/usr/bin/env python3
"""Small on-screen display for the i3 session.

Draws an override-redirect window, so it appears above fullscreen windows —
which ordinary notifications on i3 do not. Shows volume/brightness as a bar and
the keyboard layout as a badge, in the top right corner near the panel indicators.

Messages arrive on a FIFO (see the `osd` client):
    vol <0-150>|mute      brightness <0-100>      layout <NAME>
"""
import os
import re
import sys
import threading

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango  # noqa: E402

FIFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "osd.fifo")
HIDE_MS = 1100
MARGIN_TOP = 92      # below the two-row panel
MARGIN_RIGHT = 24
ACCENT = "#48daf9"

CSS = b"""
window { background: transparent; }
#osd {
    background-color: rgba(10, 14, 17, 0.92);
    border: 1px solid rgba(72, 218, 249, 0.35);
    border-radius: 12px;
    padding: 12px 16px;
}
#osd label { color: #dfe8ee; font-family: Inter; font-size: 15px; font-weight: 600; }
#osd label.glyph { font-family: "JetBrainsMono Nerd Font"; font-size: 20px; color: #48daf9; }
#osd label.badge { font-size: 26px; color: %s; letter-spacing: 2px; }
#osd label.value { color: %s; }
progressbar trough { min-height: 6px; min-width: 190px; background-color: rgba(255,255,255,0.14); border: none; border-radius: 3px; }
progressbar progress { min-height: 6px; background-color: %s; border: none; border-radius: 3px; }
""" % (ACCENT.encode(), ACCENT.encode(), ACCENT.encode())


class Osd(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)   # override-redirect: above fullscreen
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_accept_focus(False)
        self.set_focus_on_map(False)

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.box.set_name("osd")
        self.icon = Gtk.Label()
        self.icon.get_style_context().add_class("glyph")
        self.bar = Gtk.ProgressBar()
        self.bar.set_valign(Gtk.Align.CENTER)
        self.value = Gtk.Label()
        self.value.get_style_context().add_class("value")
        self.box.pack_start(self.icon, False, False, 0)
        self.box.pack_start(self.bar, True, True, 0)
        self.box.pack_start(self.value, False, False, 0)
        self.add(self.box)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        self.timer = None

    def place(self):
        """Top right corner of the monitor the pointer is on."""
        display = Gdk.Display.get_default()
        seat = display.get_default_seat()
        _, x, y = seat.get_pointer().get_position()
        monitor = display.get_monitor_at_point(x, y) or display.get_monitor(0)
        geo = monitor.get_geometry()
        self.show_all()
        w, _h = self.get_size()
        self.move(geo.x + geo.width - w - MARGIN_RIGHT, geo.y + MARGIN_TOP)

    def flash(self, icon, fraction, text, badge=False):
        ctx = self.icon.get_style_context()
        ctx.remove_class("badge")
        ctx.remove_class("glyph")
        ctx.add_class("badge" if badge else "glyph")
        self.icon.set_text(icon)
        if fraction is None:
            self.bar.hide()
            self.value.set_text(text or "")
            self.value.set_visible(bool(text))
        else:
            self.bar.set_fraction(max(0.0, min(1.0, fraction)))
            self.bar.show()
            self.value.set_text(text)
            self.value.set_visible(True)
        self.place()
        if fraction is None:
            self.bar.hide()
        self.value.set_visible(bool(self.value.get_text()))
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(HIDE_MS, self.dismiss)

    def dismiss(self):
        self.hide()
        self.timer = None
        return False

    def handle(self, line):
        parts = line.strip().split()
        if not parts:
            return
        kind, arg = parts[0], (parts[1] if len(parts) > 1 else "")
        if kind == "vol":
            if arg == "mute":
                self.flash("\uf026", 0.0, "mute")
            else:
                v = int(re.sub(r"\D", "", arg) or 0)
                # the sink can go past 100%, so the bar is scaled to 150
                self.flash("\uf028", v / 150.0 if v > 100 else v / 100.0, f"{v}%")
        elif kind == "brightness":
            v = int(re.sub(r"\D", "", arg) or 0)
            self.flash("\uf185", v / 100.0, f"{v}%")
        elif kind == "layout":
            self.flash(arg.upper(), None, "", badge=True)


def fifo_reader(osd):
    if not os.path.exists(FIFO):
        os.mkfifo(FIFO, 0o600)
    while True:
        with open(FIFO) as f:
            for line in f:
                GLib.idle_add(osd.handle, line)


def layout_watcher(osd):
    """Report keyboard layout changes as they happen (no polling)."""
    try:
        from Xlib import X, display as xdisplay
        from Xlib.ext import xkb
    except Exception:
        return
    try:
        d = xdisplay.Display()
        d.xkb_query_extension()
        d.xkb_select_events(xkb.UseCoreKbd, xkb.StateNotifyMask, xkb.StateNotifyMask,
                            0, 0, {"state_details": xkb.GroupStateMask})
        names = []
        try:
            import subprocess
            out = subprocess.check_output(["setxkbmap", "-query"], text=True)
            for ln in out.splitlines():
                if ln.startswith("layout:"):
                    names = [n.strip() for n in ln.split(":", 1)[1].split(",")]
        except Exception:
            pass
        last = None
        while True:
            ev = d.next_event()
            group = getattr(ev, "group", None)
            if group is None or group == last:
                continue
            last = group
            name = names[group] if group < len(names) else str(group)
            GLib.idle_add(osd.handle, f"layout {name}")
    except Exception as exc:  # keep the OSD alive even without layout support
        print(f"layout watcher off: {exc}", file=sys.stderr)


def main():
    osd = Osd()
    threading.Thread(target=fifo_reader, args=(osd,), daemon=True).start()
    threading.Thread(target=layout_watcher, args=(osd,), daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    main()
