#!/usr/bin/env python3
"""Battery for the panel (genmon).

This pack's batteries stop charging at ~97% because the cell is worn, and the
firmware then reports "Full". Showing 97% forever is just confusing, so a full
battery is shown as 100%.
"""
import glob
import os

ACCENT = "#48daf9"
WARN = "#e0a33e"
CRIT = "#e05561"
ICONS = os.path.expanduser("~/.local/share/panel-icons")


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


bat = next(iter(sorted(glob.glob("/sys/class/power_supply/BAT*"))), None)
if not bat:
    print("<txt></txt>")
    raise SystemExit

status = read(os.path.join(bat, "status"), "Unknown")
try:
    pct = int(read(os.path.join(bat, "capacity"), "0"))
except ValueError:
    pct = 0

plugged = status != "Discharging"
full = status == "Full" or (plugged and pct >= 97)
if plugged:
    # Full is still plugged in: keep the bolt visible instead of silently
    # switching to the ordinary full-battery drawing.
    icon, colour, label = "battery-charging.svg", ACCENT, "100%" if full else f"{pct}%"
else:
    steps = ["battery-000.svg", "battery-025.svg", "battery-050.svg",
             "battery-075.svg", "battery-100-dim.svg"]
    icon = steps[min(4, pct // 21)]
    colour = CRIT if pct <= 10 else WARN if pct <= 20 else "#c6d0d9"
    label = f"{pct}%"

# Worn batteries: show the real health in the tooltip, not in the panel.
try:
    fd = int(read(os.path.join(bat, "charge_full_design")) or read(os.path.join(bat, "energy_full_design")))
    fn = int(read(os.path.join(bat, "charge_full")) or read(os.path.join(bat, "energy_full")))
    health = f"\nHealth: {100 * fn // fd}% of design capacity"
except (ValueError, ZeroDivisionError, TypeError):
    health = ""

print(f'<img>{os.path.join(ICONS, icon)}</img>')
print(f'<txt> <span foreground="{colour}">{label}</span></txt>')
print(f'<tool>Battery: {100 if full else pct}% ({status}){health}</tool>')
