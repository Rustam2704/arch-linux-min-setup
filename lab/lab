#!/bin/bash
# lab — every change made during the desktop/memory experiments is recorded here,
# so "lab rollback" can undo all of it and leave no leftovers.
#
#   lab pkg <exp> <pkg>...        install packages (only those not already installed)
#   lab write <exp> <path>        write stdin to <path> (backs up an existing file)
#   lab undo <exp> '<command>'    record an arbitrary undo command
#   lab status                    show what is currently applied
#   lab rollback <exp|all>        undo, newest first
#
# Journal format (TSV): timestamp <TAB> experiment <TAB> action <TAB> arg1 <TAB> arg2
set -u
LAB_DIR="$(cd "$(dirname "$0")" && pwd)"
JOURNAL="$LAB_DIR/journal.tsv"
BACKUPS="$LAB_DIR/backups"
mkdir -p "$BACKUPS"
touch "$JOURNAL"

log() { printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$1" "$2" "$3" "${4-}" >> "$JOURNAL"; }

# write to a path, as root when needed, keeping a backup of what was there
cmd_write() {
    local exp="$1" path="$2" tmp bak
    tmp=$(mktemp); cat > "$tmp"
    if [ -e "$path" ]; then
        bak="$BACKUPS/$(echo "$path" | tr '/' '_').$(date +%s).bak"
        cp -a "$path" "$bak" || { echo "backup failed: $path" >&2; return 1; }
        log "$exp" backup "$path" "$bak"
    else
        log "$exp" file "$path"
    fi
    if [ -w "$(dirname "$path")" ] && { [ ! -e "$path" ] || [ -w "$path" ]; }; then
        cat "$tmp" > "$path"
    else
        sudo cp "$tmp" "$path"
    fi
    rm -f "$tmp"
    echo "wrote $path"
}

cmd_pkg() {
    local exp="$1"; shift
    local new=()
    for p in "$@"; do pacman -Qq "$p" &>/dev/null || new+=("$p"); done
    [ ${#new[@]} -eq 0 ] && { echo "already installed: $*"; return 0; }
    sudo pacman -S --needed --noconfirm "${new[@]}" || return 1
    for p in "${new[@]}"; do log "$exp" pkg "$p"; done
    echo "installed: ${new[*]}"
}

cmd_undo() { log "$1" cmd "$2"; echo "recorded undo: $2"; }

cmd_status() {
    [ -s "$JOURNAL" ] || { echo "nothing applied"; return; }
    awk -F'\t' '{printf "%-25s %-12s %-8s %s\n", $1, $2, $3, $4}' "$JOURNAL"
}

cmd_rollback() {
    local want="$1" line ts exp act a1 a2
    [ -s "$JOURNAL" ] || { echo "nothing to roll back"; return; }
    local keep=$(mktemp)
    tac "$JOURNAL" | while IFS=$'\t' read -r ts exp act a1 a2; do
        if [ "$want" != all ] && [ "$want" != "$exp" ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$exp" "$act" "$a1" "$a2" >> "$keep"; continue
        fi
        case "$act" in
            pkg)    echo "removing package $a1";  sudo pacman -Rns --noconfirm "$a1" ;;
            file)   echo "deleting $a1";          sudo rm -f "$a1" ;;
            backup) echo "restoring $a1";         sudo cp -a "$a2" "$a1" ;;
            cmd)    echo "running: $a1";          bash -c "$a1" ;;
        esac
    done
    tac "$keep" > "$JOURNAL" 2>/dev/null || : > "$JOURNAL"
    rm -f "$keep"
    echo "rollback of '$want' done"
}

case "${1-}" in
    pkg)      shift; cmd_pkg "$@" ;;
    write)    shift; cmd_write "$@" ;;
    undo)     shift; cmd_undo "$@" ;;
    status)   cmd_status ;;
    rollback) shift; cmd_rollback "${1:-all}" ;;
    *) sed -n '2,12p' "$0" ;;
esac
