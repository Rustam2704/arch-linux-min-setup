#!/bin/sh
# compositor-bench — what a repainting browser window costs Xorg, the compositor and
# Firefox under each compositor setup. It opens one Firefox window with an animated
# page (700x700 px) on the current workspace for ~25 s per setup, swaps the compositor
# between setups (the screen blinks once) and puts the real picom back at the end.
#   tools/compositor-bench                       all setups
#   tools/compositor-bench xrender xcompmgr      chosen ones: config glx glx-novsync xrender xcompmgr fastcompmgr none
set -u
S=${XDG_RUNTIME_DIR:-/tmp}/compositor-bench; mkdir -p "$S"
PAGE="$S/anim.html"; SECS=20
cat > "$PAGE" <<'HTML'
<!doctype html><title>compositor-bench</title>
<body style="margin:0;background:#000"><canvas id=c width=700 height=700></canvas>
<script>
const c=document.getElementById('c').getContext('2d');let t=0;
(function f(){t++;for(let i=0;i<60;i++){c.fillStyle=`hsl(${(t*3+i*6)%360},70%,50%)`;
c.fillRect((i*37+t*5)%700,(i*53+t*3)%700,120,120);}requestAnimationFrame(f)})();
</script>
HTML
jiffies() {  # total CPU jiffies of the processes named (exact names, or -f pattern)
    t=0
    for p in $(if [ "$1" = -f ]; then pgrep -f "$2"; else for n in "$@"; do pgrep -x "$n"; done; fi); do
        [ -r /proc/$p/stat ] && t=$((t + $(awk '{print $14+$15}' /proc/$p/stat)))
    done
    echo $t
}
stop_compositors() { for c in picom xcompmgr fastcompmgr; do pkill -x $c; done; sleep 0.6; }
start() {
    case $1 in
        config)      picom --config "$HOME/.config/picom/picom.conf" -b ;;   # the real setup
        glx)         picom --backend glx --vsync -b ;;
        glx-novsync) picom --backend glx --no-vsync -b ;;
        xrender)     picom --backend xrender --vsync -b ;;
        xcompmgr)    xcompmgr -c -C -f -r 14 -o 0.45 -l -14 -t -10 & ;;
        fastcompmgr) fastcompmgr -c -C -f -r 14 -o 0.45 -l -14 -t -10 & ;;
        none)        : ;;
    esac 2>/dev/null
}
run_setup() {
    name=$1; stop_compositors; start "$name"; sleep 2
    firefox-developer-edition --new-window "file://$PAGE" >/dev/null 2>&1 &
    sleep 8
    hz=$(getconf CLK_TCK)
    x0=$(jiffies Xorg); c0=$(jiffies picom xcompmgr fastcompmgr); f0=$(jiffies -f firefox-developer-edition/firefox)
    sleep $SECS
    x1=$(jiffies Xorg); c1=$(jiffies picom xcompmgr fastcompmgr); f1=$(jiffies -f firefox-developer-edition/firefox)
    pct() { echo "$(( ($2 - $1) * 100 / hz / SECS ))"; }
    printf "%-12s Xorg %3s%%   compositor %3s%%   firefox %3s%%\n" "$name" "$(pct $x0 $x1)" "$(pct $c0 $c1)" "$(pct $f0 $f1)"
    for w in $(xdotool search --name "compositor-bench"); do xdotool windowclose "$w"; done
    sleep 1
}
echo "each setup: ~$((SECS+9)) s with an animated 700x700 Firefox window on this workspace"
for s in ${@:-glx xrender xcompmgr fastcompmgr none}; do run_setup "$s"; done
stop_compositors; picom --config "$HOME/.config/picom/picom.conf" -b 2>/dev/null   # the real config back
echo "picom restored"
